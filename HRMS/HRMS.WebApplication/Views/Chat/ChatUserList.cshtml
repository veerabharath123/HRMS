@model List<ChatUserResponseDto>

@foreach (var user in Model)
{
    <div class="p-2 border-bottom bg-body-tertiary">
        <div class="d-flex justify-content-between">
            <div class="d-flex flex-row flex-grow-1 user-info">
                <img src="~/images/user-no-img.png" alt="avatar"
                     class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-dark" width="50">
                <div class="pt-1 user flex-grow-1 user-clickable">
                    <p class="fw-bold mb-0">@user.UserName</p>
                    <p class="small text-muted">Hello, Are you there?</p>
                </div>
            </div>
            <div class="pt-1">
                <p class="small text-muted mb-1">Just now</p>
                <span class="badge bg-success float-end new-message-icon d-center">1</span>
            </div>
        </div>
    </div>
}