@model ChatConversationResponseDto

<div class="card-title border-bottom px-3 py-2">
    <div class="bg-body-tertiary">
        <div class="d-flex justify-content-between">
            <div class="d-flex flex-row">
                <button class="chat-more-options-btn me-2" id="back-btn"><b><i class="bi bi-arrow-left"></i></b></button>
                <img src="~/images/user-no-img.png" alt="avatar"
                     class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-dark" width="40" id="open-menu">
                <div class="pt-1">
                    <p class="fw-bold mb-0">@Model.ChatUser.UserName</p>
                    <p class="small text-muted"><span></span>Online</p>
                </div>
            </div>
            <div class="dropdown d-flex flex-column justify-content-center">
                <button type="button" class="chat-more-options-btn" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu shadow">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-share-fill me-3"></i>Share</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-ban me-3"></i>Block</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-ban me-3"></i>Block</a></li>
                </ul>
            </div>

        </div>
    </div>
</div>
<div class="card-body scrollarea">
    @foreach (var m in Model.Messages)
    {
        if (m.Mine)
        {
            <div class="d-flex flex-column align-items-start mb-3">
                <div class="message-box-other message-box">
                    @m.Message
                    <div class="text-end text-action-others">
                        @m.DeliveredAt
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column align-items-end mb-3">
                <div class="message-box-mine message-box">
                    @m.Message

                    <div class="text-end text-muted text-action-mine">
                        @m.DeliveredAt
                        @if (m.Delivered)
                        {
                            <i class="bi bi-send-check-fill"></i>
                        }
                        @if (m.Seen)
                        {
                            <i class="bi bi-eye-fill"></i>
                        }
                    </div>
                </div>
            </div>
        }

    }
</div>
<div class="card-footer d-flex p-2">

    <button class="btn me-2" type="button"><i class="bi bi-emoji-smile"></i></button>
    <textarea class="form-control flex-grow-1 me-2 message-input" placeholder="Write message..." rows="1"></textarea>
    <button class="btn btn-primary me-2" type="button"><i class="bi bi-paperclip"></i></button>
    <button class="btn btn-success me-2" type="button">Send</button>
</div>