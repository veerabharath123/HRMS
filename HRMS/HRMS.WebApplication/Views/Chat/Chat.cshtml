@model List<ChatUserResponseDto>

@{
    ViewData["Module"] = "Chats";
    ViewData["Title"] = "Chats";
    for(int i = 0; i < 20; i++)
    {
        Model.Add(new ChatUserResponseDto { UserId = Guid.NewGuid(), UserName = $"Username {i}" });
    }
}
<style nonce="@Html.ScriptNonce()">
   
    .message-box{
        max-width:85%;
        border-radius:.5rem;
        padding:.5rem;
    }
    .message-box-mine{
        background-color: lightgray;
    }

    .message-box-other{
        background-color: dodgerblue;
        color: white;
    }

    .text-action-others{
        color: #ffffff96;
        font-size: .8rem;
        user-select: none;
    }
    .text-action-mine{
        font-size: .8rem;
        user-select:none;
    }
    textarea.message-input{
        resize: none;
    }
    .new-message-icon{
        aspect-ratio:1;
        border-radius:50%
    }

    #chat-box:is(.open-chat) #new-chat,
    #chat-box:not(.open-chat) #chat-screen {
        display: none;
    }

    #chat-box:is(.open-chat) #chat-screen {
        display: flex;
    }

    #chat-box:is(.open-chat) #back-btn {
        display: none;
    }
    .chat-more-options-btn{
        border: none;
        background: transparent;
        font-size: 20px;
    }
    @@media (max-width: 991px) {
        #chat-box:not(.open-chat) #chat-window {
            display: none !important;
        }

        #chat-box:is(.open-chat) #user-list {
            display: none !important;
        }

        #chat-box:is(.open-chat) #back-btn {
            display: block;
        }
    }
</style>
<div class="container-fluid h-100 py-2">
    <div class="row h-100" id="chat-box">
        <div class="col-lg-4 col-md-12 h-100" id="user-list">
            <div class="card h-100 shadow">
                <div class="card-title p-3 border-bottom">
                    <div class="row">
                        <div class="col">
                            <h1 class="mb-2">Chats</h1>
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search user">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body h-100 scrollarea">
                    <div class="list-group list-group-flush ">
                        @foreach (var user in Model)
                        {
                            <div class="p-2 border-bottom bg-body-tertiary">
                                <div class="d-flex justify-content-between">
                                    <div class="d-flex flex-row">
                                        <img src="~/images/user-no-img.png" alt="avatar"
                                             class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-dark" width="50">
                                        <div class="pt-1 user">
                                            <p class="fw-bold mb-0">@user.UserName</p>
                                            <p class="small text-muted">Hello, Are you there?</p>
                                        </div>
                                    </div>
                                    <div class="pt-1">
                                        <p class="small text-muted mb-1">Just now</p>
                                        <span class="badge bg-success float-end new-message-icon d-center">1</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8  h-100 " id="chat-window">
            <div class="card shadow h-100" id="new-chat">
                <div class="card-body h-100">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center gap-3 p-4">
                        <div class="bg-primary text-white d-center p-2 new-message-icon">
                            <i class="bi bi-chat-left-dots"></i>
                        </div>
                        <h4 class="mb-0">Select a chat to start messaging</h4>
                        <p class="text-muted">Your conversations will appear here.</p>"
                    </div>
                 </div>
            </div>
            <div class="card shadow h-100" id="chat-screen">
                <div class="card-title border-bottom px-3 py-2">
                    <div class="bg-body-tertiary">
                        <div class="d-flex justify-content-between">
                            <div class="d-flex flex-row">
                                <button class="chat-more-options-btn me-2" id="back-btn"><b><i class="bi bi-arrow-left"></i></b></button>
                                <img src="~/images/user-no-img.png" alt="avatar"
                                     class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-dark" width="40">
                                <div class="pt-1">
                                    <p class="fw-bold mb-0">Name</p>
                                    <p class="small text-muted"><span></span>Online</p>
                                </div>
                            </div>
                            <div class="dropdown d-flex flex-column justify-content-center">
                                <button type="button" class="chat-more-options-btn" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu shadow">
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-share-fill me-3"></i>Share</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="bi bi-ban me-3"></i>Block</a></li>
                                </ul>
                            </div>
                            
                        </div>
                    </div>
                </div>
                <div class="card-body scrollarea">
                    @{
                        var rnd = new Random();
                        var list = new List<(int id, string desc, bool mine, bool pre_mine)>();
                        @for (int i = 1; i < 30; i++)
                        {
                            var ismine = (rnd.Next(1, 3)) % 2 == 0;
                            list.Add((i, ("123".PadLeft(i * i, '0')), ismine, i == 1 ? false : list[i - 2].mine == ismine));
                        }
                    }
                    @foreach(var l in list)
                    {
                        if (l.mine)
                        {
                            <div class="d-flex flex-column align-items-start mb-3">
                                <div class="message-box-other message-box">
                                    Indicates a successful or positive action. @l.desc
                                    <div class="text-end text-action-others">
                                        09:00
                                    </div>
                                </div>                                
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-end mb-3">
                                <div class="message-box-mine message-box">
                                    Indicates a successful or positive action. @l.desc

                                    <div class="text-end text-muted text-action-mine">
                                        09:00
                                        <i class="bi bi-send-check-fill"></i>
                                        <i class="bi bi-eye-fill"></i>
                                    </div>
                                </div>
                            </div>
                        }

                    }
                </div>
                <div class="card-footer d-flex p-2">
                    
                    <button class="btn me-2" type="button"><i class="bi bi-emoji-smile"></i></button>
                    <textarea class="form-control flex-grow-1 me-2 message-input" placeholder="Write message..." rows="1"></textarea>
                    <button class="btn btn-primary me-2" type="button"><i class="bi bi-paperclip"></i></button>
                    <button class="btn btn-success me-2" type="button">Send</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="chat-section d-none">
    <div class="chat-persons-list active">
        <div class="people-head">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-light rounded-circle" id="toggleTheme" title="Toggle theme"><i class="bi bi-moon-fill"></i></button>
            </div>

            <div class="people-search border rounded-pill">
                <div class="input-group input-group-sm ">
                    <span class="input-group-text bg-transparent border-0"><i class="fa fa-search"></i></span>
                    <input class="form-control form-control-sm rounded-pill border-0" placeholder="Search people" id="searchPeople">
                </div>
            </div>

            <div class="d-flex ms-2 avatar-box">
                <div class="avatar avatar-sm rounded-pill bg-primary text-white d-flex align-items-center justify-content-center profile">VB</div>
            </div>
        </div>

        <div class="list-group list-group-flush" id="peopleListItems" role="tablist">
            @foreach (var user in Model)
            {
                <div class="person d-flex align-items-center" data-name="Maya Patel" data-id="@user.UserId">
                    <div class="avatar bg-info text-white">@user.UserName.FirstOrDefault()</div>
                    <div class="meta">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="name">@user.UserName</div>
                            <div class="muted small">2:18 PM</div>
                        </div>
                        <div class="msg muted"></div>
                    </div>
                </div>
            }
        </div>


        
    </div>
    <div class="chat-window">
        <div class="chat-screen">
            <div class="chat-top">
                <div class="back-btn align-items-center gap-2 ">
                    <button class="btn-minimal btn-minimal-dark"><i class="fa-solid fa-arrow-left"></i></button>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar bg-info text-white d-flex align-items-center justify-content-center">MP</div>
                    <div>
                        <div class="username"></div>
                        <div class="muted small"></div>
                    </div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button class="btn-minimal btn-minimal-dark"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                </div>
            </div>

            <div class="chat-body" id="chatBody">
                <div class="messages" id="messages">

                </div>
            </div>

            <div class="chat-input">
                <div class="input-box">
                    <button class="btn-minimal btn-minimal-dark" id="attachBtn" title="Attach"><i class="fa-solid fa-paperclip"></i></button>
                    <input id="messageInput" placeholder="Type a message" autocomplete="off">
                    <button class="btn-minimal btn-minimal-dark" id="emojiBtn" title="Emoji"><i class="fa-solid fa-face-smile"></i></button>
                </div>
                <button class="btn btn-primary rounded-pill" id="sendBtn">Send</button>
            </div>
        </div>
        <div class="no-chat-screen">
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center gap-3 p-4">
                <div class="avatar avatar-lg bg-primary text-white d-flex align-items-center justify-content-center rounded-circle">💬</div>
                <h4 class="mb-0">Select a chat to start messaging</h4>
                <p class="text-muted">Your conversations will appear here.</p>"
            </div>
        </div>
    </div>
</div>

<script nonce="@Html.ScriptNonce()">
    $('.user').on('click',function(){
        $('#chat-box').removeClass('open-chat').addClass('open-chat')
    })
    $('#back-btn').on('click',function(){
        $('#chat-box').removeClass('open-chat')
    })

    $('#sendBtn').on('click', function(){
        const messageInput = $('#messageInput');
        const message = messageInput.val().trim();
        const request = {
            message: message,
            date: new Date().toISOString(),
            userId : $('#peopleListItems .person.active').first().data('id'), // Example: get the first user's ID
            isMe : true
        };
        sendMessage(request);
    });

    function sendMessage(request){
        ajaxPost(
            '@Url.Action("SendMessage", "Chat")',
            request,
            function (result) {
                if(result?.success && result?.data){
                    createMessage(request)
                } else {
                    console.error('Failed to send message:', result?.message);
                }
            },
            { useDefaultSuccessCallBack : false }
        );
    }

    function createMessage(data){
        const message = data.message;
        const user = data.user;
        const time = new Date(data.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        const messageDiv = $(document.createElement('div'));
        messageDiv.addClass('d-flex flex-column').addClass(data.isMe ? 'align-items-end':'');

        const msgContent = document.createElement('div');
        msgContent.classList.add('msg', data.isMe ? 'from-me':'from-them');
        msgContent.textContent = message;
        messageDiv.append(msgContent);

        const timeDiv = $(document.createElement('div'));
        timeDiv.addClass('time muted');
        timeDiv.text(time);
        messageDiv.append(timeDiv);

        $('#messages').append(messageDiv)
        $('#messageInput').val('')
    }

     const connection = new signalR.HubConnectionBuilder()
        .withUrl(resolveSafeUrl(`/hubs/chat`))
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveChatMessage", (response) => {
        if(response?.success && response?.result){
            const result = response.result
            createMessage(result)
            toastr.info(result.message, result.username);
        } else {
            console.error('Failed to fetch message:', result?.message);
        }
    });

    // Start connection
    async function startConnection() {
        try {
            await connection.start();
            console.log("SignalR connected.");
        } catch (err) {
            console.error("Connection failed: ", err);
            setTimeout(startConnection, 5000); // retry
        }
    }

    startConnection();
</script>