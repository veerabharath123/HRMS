@model List<ChatConversationListResponseDto>

@{
    ViewData["Title"] = ViewBag.ModuleTitle;
    ViewData["Module"] = ViewBag.ModuleTitle;
}
<style nonce="@Html.ScriptNonce()">
    .floating-bar {
        width: 240px;
        z-index: 100000;
        transform: translateY(-100%);
        justify-self: anchor-center;
        padding: 1rem;
        transition: opacity .2s ease-in-out, transform .2s ease-in-out;
        opacity: 0;
    }
    .floating-bar.show{
        opacity: 1;
        transform: translateX(0%)
    }

    .floating-bar .progress{
        
    }
    .progress div{
        width: 0%;
    }
    .participant-img{
        object-fit: cover;
        width: 50px;
        aspect-ratio:1;
    }
    @@keyframes fadeHighlight {
        0% {
            background-color: transparent;
        }

        20%, 60% {
            background-color: #60b6dfa1;
        }

        

        100% {
            background-color: transparent;
        }
    }

    /* Apply this class once */
    .fade-highlight {
        animation: fadeHighlight 2s ease-out forwards;
    }
    @@media (max-width: 576px) {
        .img-wrapper {
            max-width: 75%;
        }
    }

    .img-wrapper .atth-download-btn {
        display: none !important;
    }

    .img-wrapper:not(.load):hover .atth-download-btn {
        display: flex !important;
    }

    .atth-download-btn{
        position: absolute;
        right: .5rem;
        bottom: .5rem;
        background: #000000a3;
        border-radius: 50%;
        width: 1.5rem;
        aspect-ratio: 1;
        color: white;
    }

    .img-wrapper.load::after {
        content: '';
        background-image: url('@Url.Content("/images/spinner.png")');  
        background-size: 30px 30px;
        position: absolute;
        aspect-ratio: 1 / 1;
        width: 30px;
    }
    .img-wrapper {
        max-width: 260px; /* WhatsApp bubble width */
        overflow: hidden;
        display:flex;
        justify-content:center;
        align-items: center;
        position: relative;
    }

    .img-wrapper .attached-img {
        width: 100%;
        height: auto;
        display: block;
        max-height: 320px; /* Prevent tall images */
        object-fit: contain; /* Keep full image visible */
        background: #f1f1f1;
        min-height: 100px;
    }
    .new-message-indicator {
        position: sticky;
        bottom: 10px;
        margin: auto;
        width: fit-content;
        background: #e1a90c;
        color: black;
        padding: 6px 12px;
        border-radius: 12px;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0px 0px 22px 5px #0000006b;
    }

    #typing-status{
        display: none ;
        padding:.5rem;
    }
    #typing-status.show {
        display: flex !important;
    }

    .user-clickable.show-typing p.typing-message,
    .user-clickable:not(.show-typing) p.last-message   {
        display: block;
    }

    .user-clickable:not(.show-typing) p.typing-message,
    .user-clickable.show-typing p.last-message {
        display: none !important;
    }
   
    .message-box, .typing-box {
        max-width:85%;
        border-radius:.5rem;
        padding:.5rem;
        font-size: .8rem;
    }
    .message-box-mine{
        background-color: lightgray;
    }

    .message-box-other, .typing-box{
        background-color: dodgerblue;
        color: white;
    }
    .message-section{
        padding: .5rem;
    }

    .message-section:has(.message-box:hover) .message-sender-name,
    .message-section:hover .message-options-btn {
        opacity: 1;
    }

    .message-type-file {
        display:flex;
        justify-content: center;
    }

    .message-sender-name{
        flex-basis:100%;
        font-size: .7rem;
        opacity: 0;
        transition: .2s opacity ease-in-out;
    }
    .message-options-btn{
        border: none;
        background: none;
        color: grey;
        margin: 0;
        padding: 0;
        opacity: 0;
        transition: .2s opacity ease-in-out;
    }
    .message-reply-box{
        padding: .5rem;
        border-radius: .3rem;
        margin-bottom: .5rem;
    }
    .message-section.message-section-other .message-reply-box{
        background: #1366b7;
    }

    .message-section:not(.message-section-other) .message-reply-box {
        background: grey;
    }

    .message-content, .message-reply-box > p {
        margin: 0;
    }

    .text-action-others{
        font-size: .7rem;
        user-select: none;
    }
    .text-action-mine{
        font-size: .7rem;
        user-select:none;
    }
    textarea.message-input{
        resize: none;
    }
    .new-message-icon{
        aspect-ratio:1;
        border-radius:50%
    }

    #chat-box:is(.open-chat) #new-chat,
    #chat-box:not(.open-chat) #chat-screen {
        display: none;
    }

    #chat-box:is(.open-chat) #chat-screen {
        display: flex;
    }

    #chat-box:is(.open-chat) #back-btn {
        display: none;
    }
    .chat-more-options-btn{
        border: none;
        background: transparent;
        font-size: 20px;
    }

    #chat-window {
        position:relative;
        overflow:hidden;
    }

    @@media (max-width: 991px) {
        #chat-box:not(.open-chat) #chat-window {
            display: none !important;
        }

        #chat-box:is(.open-chat) #user-list {
            display: none !important;
        }

        #chat-box:is(.open-chat) #back-btn {
            display: block;
        }
    }

    .reply-box{
        padding: .5rem;
        border: 1px solid lightgrey;
        background: lightgrey;
        display: flex;
        border-radius: .5rem;
        color: black;
        user-select: none;
        position: relative;
        max-width: 500px;
        width: 50%;
    }

    .reply-box span{
        cursor: pointer;
        font-size: .8rem;
    }
    .reply-box button {
        position: absolute;
        right: .5rem;
        font-size: .5rem;
    }
    .sliding-menu img{
        max-width: 150px;
        aspect-ratio: 1;
    }

    .sliding-menu{
        position: absolute;
        z-index: 10;
        top: 0;
        transition: .7s transform ease-in-out;
        width:calc(100% - 1rem);
    }

    .sliding-left{
        transform: translateX(150%);
    }

    .sliding-right {
        transform: translateX(-150%);
    }

    .sliding-down {
        transform: translateY(-150%);
    }

    .sliding-up {
        transform: translateY(150%);
    }
    .sliding-menu.show {
        transform: translateX(0) translateY(0) !important;
    }

    .drop-area{
        border: 2px dashed #ccc;
        border-radius: 10px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #999;
        font-size: 18px;
    }

    #chat-file-screen{
        display:none;
    }
    #chat-file-screen.dragover {
        display: flex !important;
    }

    #seach-emp-chat > span{
        cursor: pointer;
        transition: .2s transform ease-in;
    }

    #seach-emp-chat > span:active > i {
        transform: scale(.9)
    }

    .user-info{
        cursor: pointer;
        user-select: none;
    }

    .add-new-chat-floating-btn{
        width: 50px;
        aspect-ratio:1;
        position:absolute;
        bottom: 1rem;
        right: 1rem;
        cursor:pointer;
        transition: .2s all ease-in;
        display:flex;
        justify-content:center;
        align-items:center;
        border-radius: 50%;
    }

    .add-new-chat-floating-btn:hover{
        transform: scale(1.1)
    }

    .new-emp-clickable{
        cursor: pointer;
    }

    .new-emp-clickable:hover {
            background: #d3d3d33d
    }
</style>

<div class="container-fluid h-100 py-2">
    <div class="row h-100" id="chat-box">
        <div class="col-lg-4 col-md-12 h-100" id="user-list">
            <div class="card h-100 shadow">
                <div class="card-title p-3 border-bottom">
                    <div class="row">
                        <div class="col">
                            <h1 class="mb-4 mt-2">@ViewBag.ModuleTitle</h1>
                            <div class="input-group" id="seach-emp-chat">
                                <input type="text" class="form-control" placeholder="Search user">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body h-100 scrollarea position-relative">
                    <div class="list-group list-group-flush ">
                        <partial name="ChatUserList" model="Model" />
                       
                    </div>
                    <div class="add-new-chat-floating-btn bg-success text-light shadow" data-bs-toggle="modal" data-bs-target="#start-new-chat-modal">
                        <i class="bi bi-plus-lg"></i>
                    </div>

                    <div class="modal fade" id="start-new-chat-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered h-50">
                            <div class="modal-content h-100">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="start-new-chat-modal-label">Start a chat with</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="input-group mb-3" id="search-emp">
                                        <input type="text" class="form-control form-control-sm" />
                                        <button class="btn btn-danger btn-sm px-2"><i class="bi bi-x-circle"></i></button>
                                    </div>

                                    <ul class="list-group emp-list mb-3">
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8  h-100 " id="chat-window">
            <div class="card shadow h-100" id="new-chat">
                <div class="card-body h-100">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center gap-3 p-4">
                        <div class="bg-primary text-white d-center p-2 new-message-icon">
                            <i class="bi bi-chat-left-dots"></i>
                        </div>
                        <h4 class="mb-0">Select a chat to start messaging</h4>
                        <p class="text-muted">Your conversations will appear here.</p>"
                    </div>
                 </div>
            </div>
            <div class="card shadow h-100" id="chat-file-screen">
                <div class="card-body h-100">
                    <div class="drop-area"><i class="bi bi-file-earmark-arrow-up"></i>Drop files here</div>
                </div>
            </div>
            <div class="card shadow h-100" id="chat-screen">
               
            </div>
            <div class="sliding-menu sliding-up card h-100 p-3">
                <div class="card-body scrollarea">
                    <div class="w-100 mb-3 d-flex justify-content-start">
                        <button id="close-menu" class="btn-close float-end"></button>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-12 d-col-start mb-3">
                            <img src="~/images/user-no-img.png" alt="avatar"
                                 class="rounded-circle  bg-dark mb-3">
                            <h3>Name</h3>
                        </div>
                        <div class="col-lg-6 col-12 d-col-start">
                            <div class="d-flex w-100 gap-2 mb-2">
                                <button class="btn border p-3 col"><i class="bi bi-telephone-fill text-success"></i></button>
                                <button class="btn border p-3 col"><i class="bi bi-share-fill text-primary"></i></button>
                                <button class="btn border p-3 col"></button>
                            </div>
                            <div class="w-100 mb-2">
                                <ul class="list-group">
                                    <li class="list-group-item text-danger">Block</li>
                                    <li class="list-group-item text-danger">Report</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade show" id="chat-file-upload-modal" tabindex="-1">
        <div class="modal-dialog modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload File</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <partial name="Utilities/_FileUpload" />
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade show" id="chat-attachment-modal" tabindex="-1">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Send image</h5>
                    
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body position-relative">
                    <partial name="Utilities/_ImageViewer" />

                    <div class="floating-bar">
                        <div class="progress shadow">
                            <div id="uploadBar" class="progress-bar">0%</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex">
                    <textarea class="form-control flex-grow-1 me-2 message-input" placeholder="Write message..." rows="1" id="messageInput-attach"></textarea>
                    <button class="btn btn-outline-secondary  me-2 emoji-opener" type="button"><i class="bi bi-emoji-smile"></i></button>
                    <button class="btn btn-success send-btn d-center" type="button" id="sendBtn-attach">Send<span class="spinner-border spinner-border-sm ms-2"></span></button>
                </div>
            </div>
        </div>
    </div>
    <button class="d-none" data-bs-toggle="modal" data-bs-target="#chat-file-upload-modal"  id="attachment-btn"> click</button>
    <button class="d-none" data-bs-toggle="modal" data-bs-target="#chat-attachment-modal" id="attachment-pop-btn"> click</button>
</div>



<script nonce="@Html.ScriptNonce()">
    let loading = false;
    let hasMore = true;
    let userIsNearBottom = true;
    const MESSAGE_TYPES = {
        Text : 'Text',
        File : 'File',
    }

    const $container = $('#chat-messages');

    $('#chat-box').on({
        'drop': function (e) {
            e.preventDefault()
            $('#chat-file-screen').removeClass('dragover')
            //fileControl.trigger('file:upload',{ files: e.originalEvent.dataTransfer.files });
        },
        'dragover': function (e) {
            console.log('move')
            e.preventDefault()
            $('#chat-file-screen').addClass('dragover')
        },
        'dragleave':function(e){
            e.preventDefault()
            e?.stopPropagation()
            $('#chat-file-screen').removeClass('dragover')
        }
    })

    $(document).on('click','#open-menu',function(){
        $('.sliding-menu').addClass('show');
    });

    $(document).on('click','#close-menu',function(){
        $('.sliding-menu').removeClass('show');
    });

    $(document).on('click','.user',function(){
        const conversationId = this.id;
        const participantImg = $(this).prev()

        ajaxLoadHtml(
            '@Url.Action("GetChatConversationDetails", "Chat")',
            JSON.stringify({ Id : conversationId } ),
            '#chat-screen', 
            {
                afterLoad: function(){
                    hasMore = true;
                    $('#chat-box').removeClass('open-chat').addClass('open-chat');
                    scrollToBottom(false);
                    
                    initScrollStateTracking();
                    initLazyLoading();
                    $(`.list-group-flush #${conversationId}-status .new-message-icon`).addClass('d-none').removeClass('d-center').text('');
                    const lastMessageSection = $('#chat-messages').find('.message-section-other').last();

                    checkLastMessageForSeen(lastMessageSection, conversationId);

                    if(participantImg.length) $('#open-menu').attr('src', participantImg.attr('src'))
                    
                }
            }
        )
    });
    function checkLastMessageForSeen(lastMessageSection, conversationId){
        const lastMessageTime = lastMessageSection.find('.message-time');

        if(lastMessageTime.length && lastMessageTime.data('read')?.toLowerCase() === 'false'){
            const tillReadText = lastMessageTime.data('datetime');
            const tillReadDateTime = new Date(tillReadText);
            if(isNaN(tillReadDateTime.getTime())) return;

            updateMessageAsSeen({
                ConversationId: conversationId,
                TillRead: tillReadDateTime.toISOString()
            });
        }
    }
    function updateMessageAsSeen(request){
        ajaxPost(
            '@Url.Action("MarkMessageAsRead", "Chat")',
            JSON.stringify(request),
            function(res){
                if(!res?.success){
                    console.error('Failed to update messages as seen:', res?.message);
                    return;
                }
                
            }
        )
    }

    $(document).on('click','#back-btn',function(){
        $('#chat-box').removeClass('open-chat')
    });

    $(document).on('click','#sendBtn', function(){
        const messageText = $('#messageInput').val().trim();
        const request = initTextMessageReqest(messageText);
        sendMessage(request);
    });
    $(document).on('click','#sendHiBtn', function(){
        const messageText = "Hi.";
        const request = initTextMessageReqest(messageText);
        sendMessage(request);
    });
    function initTextMessageReqest(messageText){
        
        const conversationId = $('#messageInput').parent().attr('id');
        const parentMessageId = $('.reply-box').data('message-id') || null;

        return {
            ConversationId: conversationId,
            Content: messageText,
            ParentMessageId: parentMessageId,
            MessageType: MESSAGE_TYPES.Text
        }
    }

    $(document).on('click','#reply-container .btn-close',function(){
        const replyContainer = $('#reply-container').addClass('d-none')
        replyContainer.find('.reply-box').attr('data-message-id', null)
        replyContainer.find('span').empty();
    })

    $(document).on('click','.message-options .reply-btn',function(){
        const replyMessageId = $(this).data('message-id');
        if(replyMessageId){
            const replyContainer = $('#reply-container').removeClass('d-none');
            replyContainer.find('.reply-box').attr('data-message-id', replyMessageId)
            const message = $(`#${replyMessageId} .message-content`).text();
            replyContainer.find('span').text(message);
            $('#messageInput').trigger('focus')
        }
    })

    $(document).on('click','.message-reply-box', function(){
        const id = $(this).data('parent-id');
        if(id){

            const container = document.getElementById("chat-messages");
            const target = $(`.message-section#${id}`)[0];

            if(!target) return;

            container.scrollTop = target.offsetTop - container.offsetTop;

            target.classList.remove('fade-highlight');
            void target.offsetWidth;
            target.classList.add('fade-highlight');
        }
    })

    $(document).on('click','.copy-msg-btn', function(){
        const section = $(this).closest('.message-section');
        if(section.length){
            const message = section.find('.message-content').text()?.trim();
            if(typeof message === 'string' && message.length)
                copyToClipboard(message)
        }
    })

    function copyToClipboard(text) {
      navigator.clipboard.writeText(text)
        .then(() => {
            showNotification({ type: 'info', message: 'Text copied to clipboard' });
        })
        .catch(err => {
          console.error('Failed to copy:', err);
        });
    }

    function sendMessage(request){
        if(!request.Content?.length){
            showNotification({ type: 'warning', message: 'Message cannot be empty.' });
            return;
        }
        if(!request.ConversationId){
            return;
        }
        ajaxLoadHtml(
            '@Url.Action("SendMessage", "Chat")',
            JSON.stringify(request),
            '#typing-status',
            { 
                afterLoad: function(t,$message){
                    if(userIsNearBottom) scrollToBottom();
                    $('#messageInput').val('');

                    if(!$('#reply-container').hasClass('d-none')) 
                        $('#reply-container .btn-close').trigger('click')

                    $('#send-first-message').remove();

                },
                useDefaultSuccessCallBack : false,
                htmlMethod: 'before'
            }
        );
    }

    function createMessage(data){
        const container = $('#chat-messages');
        ajaxLoadHtml(
            '@Url.Action("CreateMessageHtml","Chat")',
            JSON.stringify(data),
            '#typing-status',
            { 
                beforeLoad: function(){
                    const nonReadMessage = container.find('.message-section-other .message-time[data-read="False"]').first()
                    $('#new-message-indicator').insertBefore(nonReadMessage.closest('.message-section-other'))
                },
                afterLoad: function(){
                    playNotificationSound('new-message-chat')
                    userIsNearBottom ? scrollToBottom() : showNewMessageIndicator();

                    $(`.list-group-flush #${data.conversationId} .last-message`).text(data.content);

                    if(!$('#chat-box').hasClass('open-chat')) return;

                    if(userIsNearBottom){
                        const lastMessageSection = container.find('.message-section-other').last();
                        checkLastMessageForSeen(lastMessageSection,data.conversationId )
                    }
                    
                },
                useDefaultSuccessCallBack : false,
                htmlMethod: 'before'mitt
            }
        );
    }

    function updateReadCount(result){
        const convoElem = $(`.list-group-flush #chat-convo-card-${result.conversationId}`);
        const readCountElem = convoElem.find(".new-message-icon");
        const messageElem = convoElem.find(".last-message");
        const dateElem = convoElem.find(".last-message-date");

        if (parseInt(result.unreadCount) === 0) {
            readCountElem.addClass("d-none").removeClass("d-center");
        } else {
            readCountElem.removeClass("d-none").addClass("d-center");
            readCountElem.text(result.unreadCount);
        }

        const oldMessageId = parseInt(messageElem.data("last-message-id"));
        const newMessageId = parseInt(result.id);

        if (!oldMessageId || newMessageId > oldMessageId) {
            messageElem.text(result.content);
            messageElem.attr("data-last-message-id", newMessageId)
            dateElem.text(formatChatDate(result.createdDateUtc))
            convoElem.prependTo('.list-group-flush');
        }
    }

    function formatChatDate(utcIsoString) {
        const date = new Date(utcIsoString);
        const now = new Date();

        const isToday =
            date.getFullYear() === now.getFullYear() &&
            date.getMonth() === now.getMonth() &&
            date.getDate() === now.getDate();

        if (isToday) {
            return date.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            });
        }

        return date.toLocaleDateString('en-GB', {
            day: '2-digit',
            month: '2-digit'
        });
    }

    $('#search-emp input').on('input', function () {
        const val = this.value.trim();

        if (!val?.length || val.length <= 2)
            return;

        getEmployeeList(val);
    });

    $('#search-emp button').on('click', function () {
        $('.emp-list').empty();
        $('#search-emp input').val('');
    });

    $(document).on('click','.new-emp-clickable',function(){
        if(!this.id) return

        ajaxLoadHtml(
            '@Url.Action("StartNewChatWith","Chat")',
            JSON.stringify({ Id : this.id }),
            '.list-group-flush',
            {
                afterLoad: function(){
                    const modal = bootstrap.Modal.getInstance(document.getElementById('start-new-chat-modal'));
                    modal.hide();
                }
            }
        )
    });

    function getEmployeeList(name){
        ajaxPost(
            '@Url.Action("GetEmployeeSearchListByNameOrEmail","Employee")',
            JSON.stringify({ SearchText : name }),
            function(res){
                const empList = $('.emp-list').empty();
                
                if(!res?.length){
                    const li = document.createElement('li');
                    li.classList.add('list-group-item','text-center','text-muted');
                    li.textContent = 'No employees found.';
                    empList.append(li);
                } else{
                    res.forEach(x =>{
                         const li = document.createElement('li');
                        li.classList.add('list-group-item','text-start', 'new-emp-clickable');
                        li.textContent = `${x.fullName}:${x.email}`;
                        li.id = x.id;
                        empList.append(li);
                    })
                }
            }
        )
    }
    function updateTypingStatus(result){
        
        if(!$('#chat-box').hasClass('open-chat')){
            updateTypingStatusInChatList(result)
            return;
        }

        if(result.isTyping){
            $('#typing-status').addClass('show')
            $(`#${result.conversationId}.user-clickable`).addClass('show-typing')
            $('.profile-status').text('Typing...')
        } else{
            $('#typing-status').removeClass('show')
            $(`#${result.conversationId}.user-clickable`).removeClass('show-typing')
            $('.profile-status').text('Online')
        }

        if(userIsNearBottom) scrollToBottom();
    }
    function updateTypingStatusInChatList(result){
        if(result.isTyping){
            $(`#${result.conversationId}.user-clickable`).addClass('show-typing')
        } else{
            $(`#${result.conversationId}.user-clickable`).removeClass('show-typing')
        }
    }

    let typingTimeout;
    let isTyping = false;
    let debounceTimer;
    const typingTimeoutMs = 3000

    $(document).on("keydown", "#messageInput,#messageInput-attach", function (e) {
        if (e.key === "Enter") {
            if (e.shiftKey) return;
            e.preventDefault();

            $(e.target).closest('div').find('.send-btn').trigger('click');
            clearTimeout(debounceTimer);
            clearTimeout(typingTimeout);
            const conversationId = $('#chat-messages').data('conversation');
            SendTypingStatus({
                ConversationId: conversationId,
                IsTyping: false
            });
        }
    })

    $(document).on("input", "#messageInput,#messageInput-attach", function (e) {
        const conversationId = $('#chat-messages').data('conversation');

        const request = {
            ConversationId: conversationId,
            IsTyping: true
        };

        clearTimeout(debounceTimer);
        clearTimeout(typingTimeout);
        debounceTimer = setTimeout(() => {

            if (!isTyping) {
                isTyping = true;
                request.IsTyping = true;
                SendTypingStatus(request);
            }

            clearTimeout(typingTimeout);
            typingTimeout = setTimeout(() => {
                isTyping = false;

                SendTypingStatus({
                    ConversationId: conversationId,
                    IsTyping: false
                });
            }, typingTimeoutMs);

        }, 300);
    });
    $(document).on('keydown', function (e) {

        // Only plain "m" or "M"
        if (e.key.toLowerCase() !== 'm') return;

        // Ignore if modifier keys are pressed
        if (e.ctrlKey || e.altKey || e.metaKey) return;

        const $target = $(e.target);

        // Ignore if user is already typing somewhere
        if ($target.is('input, textarea, [contenteditable="true"]')) return;

        const $input = $('#messageInput');

        // Focus only if not already focused
        if (!$input.is(':focus')) {
            e.preventDefault();
            $input.trigger('focus');
        }
    });

    $(document).on("blur", "#messageInput,#messageInput-attach", function () {
        const conversationId = $('#chat-messages').data('conversation');

        if (isTyping) {
            isTyping = false;
            SendTypingStatus({
                ConversationId: conversationId,
                IsTyping: false
            });
        }

        clearTimeout(typingTimeout);
        clearTimeout(debounceTimer);
    });


    function SendTypingStatus(request){
        ajaxPost(
            '@Url.Action("SendTypingStatus", "Chat")',
            JSON.stringify(request),
            function(res){
               
            }
        )
    }
    

    function initLazyLoading() {
        $('#chat-messages').off('scroll.lazy').on('scroll.lazy', function () {
            if (this.scrollTop <= 5) {
                getPreviousMessages($('#chat-messages').data('conversation'));
            }
        });
    }
    function getPreviousMessages(conversationId) {
        if (loading || !hasMore) return;

        const firstMessage = $('#chat-messages').find('.message-section').first();

        if (!firstMessage.length) return;

        const timeElem = firstMessage.find('.message-time');
        const tillReadText = timeElem.data('datetime');

        const tillReadDateTime = new Date(tillReadText);
        if (isNaN(tillReadDateTime.getTime())) return;

        loading = true;

        const previousScrollHeight = $('#chat-messages')[0].scrollHeight;

        ajaxLoadHtml(
            '@Url.Action("GetPreviousMessages", "Chat")',
            JSON.stringify({
                ConversationId: conversationId,
                LastMessageTime: tillReadDateTime.toISOString()
            }),
            '#chat-messages',
            {
                htmlMethod: 'prepend',
                useDefaultSuccessCallBack: false,
                afterLoad: function () {

                    const newScrollHeight = $('#chat-messages')[0].scrollHeight;
                    $('#chat-messages').scrollTop(newScrollHeight - previousScrollHeight);

                    if ($('#chat-messages').find('.message-section').first()[0] === firstMessage[0]) {
                        hasMore = false;
                    }

                    loading = false;
                }
            }
        );
    }
    
    const BOTTOM_TOLERANCE = 50; // px
    const debouncedHideIndicator = debounceFn(hideNewMessageIndicator, 500);
    function initScrollStateTracking() {
        $('#chat-messages').off('scroll').on('scroll', function() {
            const distanceFromBottom =
                this.scrollHeight - this.scrollTop - this.clientHeight;

            userIsNearBottom = distanceFromBottom <= BOTTOM_TOLERANCE;

            // Hide indicator when user scrolls back down
            if (userIsNearBottom) {
                debouncedHideIndicator()
            }
        });
    }

    function scrollToBottom(smooth = true) {
        const chat = document.getElementById('chat-messages');

        chat.scrollTo({
            top: chat.scrollHeight,
            behavior: smooth ? 'smooth' : 'auto'
        });
    }

    function showNewMessageIndicator() {
        $('#new-message-indicator').removeClass('d-none');
    }

    function hideNewMessageIndicator() {
        const lastMessageSection =  $('#chat-messages').find('.message-section-other').last();
        checkLastMessageForSeen(lastMessageSection,$('#chat-messages').data('conversation'))
        $('#new-message-indicator').addClass('d-none');
    }
    
    $(document).on('click','#new-message-indicator',function(){
        scrollToBottom()
        hideNewMessageIndicator()
    })
    const attachmentViewer = ImageViewerFactory.create({
        modalId: '#chat-attachment-modal',
        imageId: '#chat-attachment-modal .preview-image',
        zoomInBtnId: '#chat-attachment-modal .zoomInBtn',
        zoomOutBtnId: '#chat-attachment-modal .zoomOutBtn',
        resetBtnId: '#chat-attachment-modal .resetZoomBtn',
        downloadBtnId: '#chat-attachment-modal .downloadAttachmentBtn',

        enableZoomButtons: true,
        enableWheelZoom: true,
        enableDrag: true,
        enablePinchZoom: true,
        enableDoubleClickZoom: true,
        enableDownload: true
    });
    const uploadModal = document.getElementById('chat-file-upload-modal');
    const previewModal = document.getElementById('chat-attachment-modal');

    const $previewImg = $('#chat-attachment-modal img');
    const $messageInput = $('#messageInput-attach');
    const $sendBtn = $('#sendBtn-attach');

    let currentFile = null;
    let currentObjectUrl = null;

    $('#chat-file-upload-modal #upload').on('file:upload', function (e, files) {
        const file = files?.files?.[0];
        if (!file) return;

        preparePreview(file);
        showPreviewModal();
    });

    function preparePreview(file) {
        cleanupObjectUrl();

        currentFile = file;
        currentObjectUrl = URL.createObjectURL(file);
        attachmentViewer.open(currentObjectUrl)
        $messageInput.val('');
    }

    function showPreviewModal() {
        $('.floating-bar').removeClass('show')
        $('#attachment-pop-btn').trigger('click');
        bootstrap.Modal.getInstance(uploadModal)?.hide();
    }

    $sendBtn.on('click', function () {
        if (!currentFile) return;

        toggleSendButton(true);
        uploadFile(currentFile);
    }).find('span').hide();

    function uploadFile(file) {
        $('#uploadBar').text('').removeClass('progress-bar-striped progress-bar-animated')
        const formData = new FormData();
        formData.append('file', file);

        ajaxPostFile(
            '@Url.Action("FileUpload", "File")',
            formData,
            handleUploadSuccess,
            { 
                useDefaultSuccessCallBack: false,
                onProgress: function(p){
                    $('.floating-bar').addClass('show')
                     $('#uploadBar')
                        .css('width', p.percent + '%')
                        .text(p.percent + '%');

                    if(ppercent == '100'){
                        $('#uploadBar').text('').addClass('progress-bar-striped progress-bar-animated')
                    }
                }
            }
        );
    }

    function handleUploadSuccess(res) {
        toggleSendButton(false);

        if (!res?.success || !res?.data) return;

        closePreviewModal();
        sendChatMessage(res.data);
        cleanupObjectUrl();
        attachmentViewer.reset()
    }

    function sendChatMessage(fileId) {
        sendMessage({
            ConversationId: $('#chat-messages').data('conversation'),
            Content: $messageInput.val(),
            ParentMessageId: null,
            MessageType: MESSAGE_TYPES.File,
            FileId: fileId
        });
    }

    function toggleSendButton(disabled) {
        $sendBtn.prop('disabled', disabled);
        $sendBtn.find('span').toggle(disabled);
    }

    function closePreviewModal() {
        bootstrap.Modal.getInstance(previewModal)?.hide();
    }

    function cleanupObjectUrl() {
        if (currentObjectUrl) {
            URL.revokeObjectURL(currentObjectUrl);
            currentObjectUrl = null;
        }
        currentFile = null;
    }



    $(document).on('click','#add-attachment-btn', function(){
        $('#attachment-btn').trigger('click')
    })
    function handleChatImage(img) {
        const container = img.closest('.message-type-file');
        if (!container) return;

        // Case 1: Image already loaded (cache)
        if (img.complete && img.naturalWidth !== 0) {
            container.classList.remove('load');
            if(userIsNearBottom) scrollToBottom();
            return;
        }

        // Case 2: Image loads later
        const onDone = () => {
            container.classList.remove('load');
            img.removeEventListener('load', onDone);
            img.removeEventListener('error', onDone);
            if(userIsNearBottom) scrollToBottom();
        };

        img.addEventListener('load', onDone);
        img.addEventListener('error', onDone);
    }

    const observer = new MutationObserver(mutations => {
        mutations.forEach(m => {
            m.addedNodes.forEach(node => {
                if (node.nodeType === 1) {
                    node.querySelectorAll?.('.message-type-file img')?.forEach(handleChatImage);
                }
            });
        });
    });

    observer.observe(document.body, { childList: true, subtree: true });
    
    EmojiPicker.create({
        namespace: 'chat',
        triggerSelector: '#openEmojiModal',
        inputContainerSelector: '#chat-window',
        inputSelector: '.message-input'
    });
    EmojiPicker.create({
        namespace: 'chat-attach',
        triggerSelector: '#chat-attachment-modal .emoji-opener',
        inputContainerSelector: '#chat-attachment-modal',
        inputSelector: '.message-input'
    });

    function updateOnlineStatus(conversationIds){
        const chat = $('#chat-messages').data('conversation');
        conversationIds.forEach(c =>{
            if(chat === c){
                $('#chat-window').find('.profile-status').text('Online')
            }
        })
    }
    function updateOfflineStatus(conversationIds){
        const chat = $('#chat-messages').data('conversation');
        conversationIds.forEach(c =>{
            if(chat === c){
                $('#chat-window').find('.profile-status').text('Offline')
            }
        })
    }
</script>