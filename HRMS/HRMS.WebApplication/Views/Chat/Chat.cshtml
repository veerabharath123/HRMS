@model List<ChatConversationListResponseDto>

@{
    ViewData["Module"] = "Chats";
    ViewData["Title"] = "Chats";
}
<style nonce="@Html.ScriptNonce()">
   
    .message-box{
        max-width:85%;
        border-radius:.5rem;
        padding:.5rem;
    }
    .message-box-mine{
        background-color: lightgray;
    }

    .message-box-other{
        background-color: dodgerblue;
        color: white;
    }

    .text-action-others{
        color: #ffffff96;
        font-size: .8rem;
        user-select: none;
    }
    .text-action-mine{
        font-size: .8rem;
        user-select:none;
    }
    textarea.message-input{
        resize: none;
    }
    .new-message-icon{
        aspect-ratio:1;
        border-radius:50%
    }

    #chat-box:is(.open-chat) #new-chat,
    #chat-box:not(.open-chat) #chat-screen {
        display: none;
    }

    #chat-box:is(.open-chat) #chat-screen {
        display: flex;
    }

    #chat-box:is(.open-chat) #back-btn {
        display: none;
    }
    .chat-more-options-btn{
        border: none;
        background: transparent;
        font-size: 20px;
    }

    #chat-window {
        position:relative;
        overflow:hidden;
    }

    @@media (max-width: 991px) {
        #chat-box:not(.open-chat) #chat-window {
            display: none !important;
        }

        #chat-box:is(.open-chat) #user-list {
            display: none !important;
        }

        #chat-box:is(.open-chat) #back-btn {
            display: block;
        }
    }
    .sliding-menu img{
        max-width: 150px;
        aspect-ratio: 1;
    }

    .sliding-menu{
        position: absolute;
        z-index: 10;
        top: 0;
        transition: .7s transform ease-in-out;
        width:calc(100% - 1rem);
    }

    .sliding-left{
        transform: translateX(150%);
    }

    .sliding-right {
        transform: translateX(-150%);
    }

    .sliding-down {
        transform: translateY(-150%);
    }

    .sliding-up {
        transform: translateY(150%);
    }
    .sliding-menu.show {
        transform: translateX(0) translateY(0) !important;
    }

    #seach-emp-chat > span{
        cursor: pointer;
        transition: .2s transform ease-in;
    }

    #seach-emp-chat > span:active > i {
        transform: scale(.9)
    }

    .user-info{
        cursor: pointer;
        user-select: none;
    }

    .add-new-chat-floating-btn{
        width: 50px;
        aspect-ratio:1;
        position:absolute;
        bottom: 1rem;
        right: 1rem;
        cursor:pointer;
        transition: .2s all ease-in;
        display:flex;
        justify-content:center;
        align-items:center;
        border-radius: 50%;
    }

    .add-new-chat-floating-btn:hover{
        transform: scale(1.1)
    }

    .new-emp-clickable{
        cursor: pointer;
    }

    .new-emp-clickable:hover {
            background: #d3d3d33d
    }
</style>

<div class="container-fluid h-100 py-2">
    <div class="row h-100" id="chat-box">
        <div class="col-lg-4 col-md-12 h-100" id="user-list">
            <div class="card h-100 shadow">
                <div class="card-title p-3 border-bottom">
                    <div class="row">
                        <div class="col">
                            <h1 class="mb-4 mt-2">Chats</h1>
                            <div class="input-group" id="seach-emp-chat">
                                <input type="text" class="form-control" placeholder="Search user">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body h-100 scrollarea position-relative">
                    <div class="list-group list-group-flush ">
                        <partial name="ChatUserList" model="Model" />
                    </div>
                    <div class="add-new-chat-floating-btn bg-success text-light shadow" data-bs-toggle="modal" data-bs-target="#start-new-chat-modal">
                        <i class="bi bi-plus-lg"></i>
                    </div>

                    <div class="modal fade" id="start-new-chat-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered h-50">
                            <div class="modal-content h-100">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="start-new-chat-modal-label">Start a chat with</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="input-group mb-3" id="search-emp">
                                        <input type="text" class="form-control form-control-sm" />
                                        <button class="btn btn-danger btn-sm px-2"><i class="bi bi-x-circle"></i></button>
                                    </div>

                                    <ul class="list-group emp-list mb-3">
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8  h-100 " id="chat-window">
            <div class="card shadow h-100" id="new-chat">
                <div class="card-body h-100">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center gap-3 p-4">
                        <div class="bg-primary text-white d-center p-2 new-message-icon">
                            <i class="bi bi-chat-left-dots"></i>
                        </div>
                        <h4 class="mb-0">Select a chat to start messaging</h4>
                        <p class="text-muted">Your conversations will appear here.</p>"
                    </div>
                 </div>
            </div>
            <div class="card shadow h-100" id="chat-screen">
               
            </div>
            <div class="sliding-menu sliding-up card h-100 p-3">
                <div class="card-body scrollarea">
                    <div class="w-100 mb-3 d-flex justify-content-start">
                        <button id="close-menu" class="btn-close float-end"></button>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-12 d-col-start mb-3">
                            <img src="~/images/user-no-img.png" alt="avatar"
                                 class="rounded-circle  bg-dark mb-3">
                            <h3>Name</h3>
                        </div>
                        <div class="col-lg-6 col-12 d-col-start">
                            <div class="d-flex w-100 gap-2 mb-2">
                                <button class="btn border p-3 col"><i class="bi bi-telephone-fill text-success"></i></button>
                                <button class="btn border p-3 col"><i class="bi bi-share-fill text-primary"></i></button>
                                <button class="btn border p-3 col"></button>
                            </div>
                            <div class="w-100 mb-2">
                                <ul class="list-group">
                                    <li class="list-group-item text-danger">Block</li>
                                    <li class="list-group-item text-danger">Report</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script nonce="@Html.ScriptNonce()">
    $(document).on('click','#open-menu',function(){
        $('.sliding-menu').addClass('show');
    });

    $(document).on('click','#close-menu',function(){
        $('.sliding-menu').removeClass('show');
    });

    $('.user').on('click',function(){
        const conversationId = this.id;

        ajaxLoadHtml(
            '@Url.Action("GetChatConversationDetails", "Chat")',
            JSON.stringify({ Id : conversationId } ),
            '#chat-screen',
            {
                afterLoad: function(){
                    $('#chat-box').removeClass('open-chat').addClass('open-chat')
                    const container = $('#chat-messages')[0]
                    const message = $('#chat-messages').find('.message-section:last-child')[0];

                    container.scrollTop = message.offsetTop;
                    debugger
                    const lastMessageSection = $(container).find('.message-section-other').last().find('.message-time');

                    if(lastMessageSection.data('read')?.toLowerCase() === 'false'){
                        const tillReadText = lastMessageSection.data('datetime');
                        const tillReadDateTime = new Date(tillReadText);
                        if(isNaN(tillReadDateTime.getTime())) return;

                        updateMessageAsSeen({
                            ConversationId: conversationId,
                            TillRead: tillReadDateTime
                        });
                    }
                }
            }
        )
    });
    function updateMessageAsSeen(request){
        ajaxPost(
            '@Url.Action("MarkMessageAsRead", "Chat")',
            JSON.stringify(request),
            function(res){
                if(!res?.success){
                    console.error('Failed to update messages as seen:', res?.message);
                }
            }
        )
    }

    $(document).on('click','#back-btn',function(){
        $('#chat-box').removeClass('open-chat')
    });

    $(document).on('click','#sendBtn', function(){
        const messageInput = $('#messageInput');
        const message = messageInput.val().trim();
        const conversationId = messageInput.parent().attr('id');

        sendMessage({
            ConversationId: conversationId,
            Content: message,
            ParentMessageId: null
        });
    });

    function sendMessage(request){
        if(!request.Content?.length){
            toastr.warning('Message cannot be empty.');
            return;
        }
        if(!request.ConversationId){
            return;
        }
        ajaxLoadHtml(
            '@Url.Action("SendMessage", "Chat")',
            JSON.stringify(request),
            '#chat-messages',
            { 
                afterLoad: function($target){
                    const container = $target[0];
                    const message = $target.find('.message-section:last-child')[0];

                    container.scrollTop = message.offsetTop;
                    $('#messageInput').val('');
                },
                useDefaultSuccessCallBack : false,
                htmlMethod: 'append'
            }
        );
    }

    function createMessage(data){
        ajaxLoadHtml(
            '@Url.Action("CreateMessageHtml","Chat")',
            JSON.stringify(data),
            '#chat-messages',
            { 
                afterLoad: function($target){
                    const container = $target[0];
                    const message = $target.find('.message-section:last-child')[0];
                    container.scrollTop = message.offsetTop;

                    const lastMessageSection = $target.find('.message-section-other').last().find('.message-time');

                    if(!$('#chat-box').hasClass('open-chat')) return;

                    if(lastMessageSection.data('read')?.toLowerCase() === 'false'){
                        const tillReadText = lastMessageSection.data('datetime');
                        const tillReadDateTime = new Date(tillReadText);
                        if(isNaN(tillReadDateTime.getTime())) return;

                        updateMessageAsSeen({
                            ConversationId: data.conversationId,
                            TillRead: tillReadDateTime
                        });
                    }
                },
                useDefaultSuccessCallBack : false,
                htmlMethod: 'append'
            }
        );
    }

    const connection = new signalR.HubConnectionBuilder()
                        .withUrl(resolveSafeUrl(`/hubs/chat`))
                        .withAutomaticReconnect()
                        .build();

    connection.on("ReceiveChatMessage", (response) => {
        if(response?.success && response?.result){
            const result = response.result;
            createMessage(result);

            if(!$('#chat-box').hasClass('open-chat')){
                toastr.info(result.content, result.senderName);
            }
        } else {
            console.error('Failed to fetch message:', result?.message);
        }
    });

    connection.on("ReceiveDeliveredStatus", (response) => {
        if(response?.success && response?.result){
            const result = response.result;

            if($('#chat-box').hasClass('open-chat') && result){
                $(`#chat-messages .message-section#${result} .delivered-status`).removeClass("d-none")
            }
        } else {
            console.error('Failed to fetch message:', result?.message);
        }
    });

    connection.on("ReceiveSeenStatus", (response) => {
        debugger
        if(response?.success && response?.result){
            const result = response.result;

            if($('#chat-box').hasClass('open-chat') && result?.length){
                result.forEach(id => {
                    $(`#chat-messages .message-section#${id} .read-at`).removeClass("d-none")
                });
            }
        } else {
            console.error('Failed to fetch message:', result?.message);
        }
    });

    // Start connection
    async function startConnection() {
        try {
            await connection.start();
            console.log("SignalR connected.");
        } catch (err) {
            console.error("Connection failed: ", err);
            setTimeout(startConnection, 5000); // retry
        }
    }

    startConnection();

    $('#search-emp input').on('input', function () {
        const val = this.value.trim();

        if (!val?.length || val.length <= 2)
            return;

        getEmployeeList(val);
    });

    $('#search-emp button').on('click', function () {
        $('.emp-list').empty();
        $('#search-emp input').val('');
    });

    $(document).on('click','.new-emp-clickable',function(){
        if(!this.id) return

        ajaxLoadHtml(
            '@Url.Action("StartNewChatWith","Chat")',
            JSON.stringify({ Id : this.id }),
            '.list-group-flush',
            {
                afterLoad: function(){
                    const modal = bootstrap.Modal.getInstance(document.getElementById('start-new-chat-modal'));
                    modal.hide();
                }
            }
        )
    });

    function getEmployeeList(name){
        ajaxPost(
            '@Url.Action("GetEmployeeSearchListByNameOrEmail","Employee")',
            JSON.stringify({ SearchText : name }),
            function(res){
                const empList = $('.emp-list').empty();
                
                if(!res?.length){
                    const li = document.createElement('li');
                    li.classList.add('list-group-item','text-center','text-muted');
                    li.textContent = 'No employees found.';
                    empList.append(li);
                } else{
                    res.forEach(x =>{
                         const li = document.createElement('li');
                        li.classList.add('list-group-item','text-start', 'new-emp-clickable');
                        li.textContent = `${x.fullName}:${x.email}`;
                        li.id = x.id;
                        empList.append(li);
                    })
                }
            }
        )
    }
</script>