@model List<ChatUserResponseDto>

@{
    ViewData["Module"] = "Chats";
    ViewData["Title"] = "Chats";
    for(int i = 0; i < 20; i++)
    {
        Model.Add(new ChatUserResponseDto { UserId = Guid.NewGuid(), UserName = $"Username {i}" });
    }
}
<style nonce="@Html.ScriptNonce()">
    .chat-section {
        max-width: 1200px;
        margin: 0 auto;
        height: calc(100vh - 2rem);
        display: grid;
        grid-template-columns: 312px 1fr;
        gap: 1rem;
        overflow-y:auto
    }

    /* Responsive: collapse to single column on small screens */
    @@media (max-width: 992px) {
        .chat-section {
            grid-template-columns: 1fr;
        }

        .no-chat-screen, .chat-window, .chat-persons-list {
            display: none !important;
        }

        .chat-screen, .chat-window.active {
            display:flex !important
        }

            .chat-persons-list.active{
                display:block !important
            }
        

        .back-btn{
            display: flex !important;
        }
    }

    .back-btn {
        display: none
    }

    .people-head {
        padding: 1rem;
        display: flex;
        gap: .75rem;
        align-items: center;
        border-bottom: 1px solid rgba(0,0,0,0.04);
    }

    .chat-section .profile {
        width: 40px;
        height: 40px;
        border-radius: 10px
    }

    .people-search {
        flex: 1
    }

    .chat-window {
        background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.01) 100%);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: auto;
        max-height: calc(100% - 3rem);
        display: flex;
        flex-direction: column;
    }

    .people-list .list-group {
        border-radius: 0;
        background: transparent;
        padding: .5rem 0;
        overflow: auto;
    }

    .person {
        padding: .6rem 1rem;
        display: flex;
        gap: .75rem;
        align-items: center;
        cursor: pointer;
        transition: background .12s ease, transform .06s ease;
        border-radius: 10px;
        margin: .2rem .5rem;
    }

        .person:hover {
            background: rgba(0,0,0,0.03);
            transform: translateY(-1px);
        }

    body.dark .person:hover {
        background: rgba(255,255,255,0.02);
    }

    .person .meta {
        flex: 1;
        min-width: 0
    }

    .person .name {
        font-weight: 600;
        font-size: .95rem
    }

    .person .msg {
        font-size: .82rem;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .person .avatar {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700
    }

    /* mini sidebar icons (for narrow screens when collapsed) */
    .people-mini {
        display: none;
        flex-direction: column;
        gap: .4rem;
        background: transparent
    }
    @@media (max-width:420px) {
        .people-mini

    {
        display: flex
    }

    .people-head .people-search {
        display: none
    }

    .people-head .btn {
        display: none
    }

    }

    .chat-top {
        padding: .9rem 1.2rem;
        border-bottom: 1px solid rgba(0,0,0,0.04);
        display: flex;
        align-items: center;
        gap: .75rem;
        background: linear-gradient(0deg, rgba(255,255,255,0.02), transparent);
    }

    .chat-body {
        padding: 1rem;
        flex: 1;
        overflow: auto
    }

    .messages {
        display: flex;
        flex-direction: column;
        gap: .6rem;
        max-width: 900px
    }

    .msg {
        padding: .55rem .8rem;
        border-radius: 12px;
        display: inline-block;
        max-width: 70%;
        box-shadow: 0 6px 18px rgba(12,20,40,0.04)
    }

    body.dark .msg {
        box-shadow: none
    }

    .from-me {
        align-self: flex-end;
        background: lightgrey;
        border-bottom-right-radius: 6px
    }

    .from-them {
        align-self: flex-start;
        background: dodgerblue;
        color:white;
        border-bottom-left-radius: 6px
    }

    .time {
        font-size: .72rem;
        color: var(--muted);
        margin-top: .28rem
    }

    .chat-input {
        padding: .7rem;
        border-top: 1px solid rgba(0,0,0,0.04);
        display: flex;
        gap: .6rem;
        align-items: center;
        background: linear-gradient(0deg, rgba(255,255,255,0.01), transparent);
    }

    body.dark .chat-input {
        border-top-color: rgba(255,255,255,0.04);
    }

    .input-box {
        flex: 1;
        display: flex;
        gap: .5rem;
        align-items: center;
        background: var(--card);
        padding: .45rem;
        border-radius: 12px
    }

        .input-box input {
            border: 0;
            background: transparent;
            outline: none;
            padding: .5rem;
            width: 100%
        }

    /* subtle badges */
    .badge-unread {
        background: linear-gradient(90deg,var(--accent),#2b6df6);
        border-radius: 999px;
        color: white;
        padding: .18rem .5rem;
        font-size: .75rem
    }

    /* small helpers */
    .muted {
        color: var(--muted)
    }

    /* make scrollbars subtle */
    .people-list .list-group::-webkit-scrollbar, .chat-body::-webkit-scrollbar {
        height: 8px;
        width: 8px
    }

    .people-list .list-group::-webkit-scrollbar-thumb, .chat-body::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.08);
        border-radius: 999px
    }

    body.dark .people-list .list-group::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.05)
    }

    .avatar-box{
        gap: 8px;
        align-items: center
    }

    .chat-top .avatar{
        width: 48px;
        height: 48px;
        border-radius: 12px
    }

    .chat-top .username{
        font-weight: 700
    }

    .chat-screen{
        display: none;
        flex-direction: column;
        height: 100%
    }

    .chat-screen.active{
        display:flex
    }

    .no-chat-screen{
        display: none;
    }

    .no-chat-screen.active{
        display: block
    }

    #messageInput{
        background: #d3d3d380;
        border-radius: 20px;
        padding:10px 20px;
    }
    .messages{
        max-width:85%;
    }
</style>
<div class="container-fluid h-100 py-2">
    <div class="row h-100">
        <div class="col-lg-4 col-md-12 h-100">
            <div class="card h-100 shadow">
                <div class="card-title p-3 border-bottom">
                    <div class="row">
                        <div class="col">
                            <h1 class="mb-2">Chats</h1>
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search user">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body h-100 scrollarea">
                    <div class="list-group list-group-flush ">
                        @foreach (var user in Model)
                        {
                            <div class="p-2 border-bottom bg-body-tertiary">
                                <div class="d-flex justify-content-between">
                                    <div class="d-flex flex-row">
                                        <img src="~/images/user-no-img.png" alt="avatar"
                                             class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-dark" width="50">
                                        <div class="pt-1">
                                            <p class="fw-bold mb-0">@user.UserName</p>
                                            <p class="small text-muted">Hello, Are you there?</p>
                                        </div>
                                    </div>
                                    <div class="pt-1">
                                        <p class="small text-muted mb-1">Just now</p>
                                        <span class="badge bg-success float-end">1</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8  h-100">
           @*  <div class="card shadow h-100 d-md-none d-lg-block">
                <div class="card-body h-100">
                    <div class="d-flex justify-content-center align-items-center h-100 flex-column">
                        
                        <div class="border p-3 rounded d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-chat-dots-fill text-primary"></i>
                            <b>Start new chat</b>
                            
                        </div>
                    </div>
                 </div>
            </div> *@
            <div class="card shadow h-100">
                <div class="card-title border-bottom px-3 py-2">
                    <div class="bg-body-tertiary">
                        <div class="d-flex justify-content-between">
                            <div class="d-flex flex-row">
                                <img src="~/images/user-no-img.png" alt="avatar"
                                     class="rounded-circle d-flex align-self-center me-3 shadow-1-strong bg-dark" width="40">
                                <div class="pt-1">
                                    <p class="fw-bold mb-0">Name</p>
                                    <p class="small text-muted"><span></span>Online</p>
                                </div>
                            </div>
                            <div class="pt-1 d-flex flex-column justify-content-center">
                                <i class="bi bi-three-dots-vertical"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body scrollarea">
                    @for(int i = 1; i <30; i++)
                    {
                        if (i%2==0)
                        {
                            <div class="d-flex flex-column align-items-start">
                                <div class="alert alert-primary message">
                                    Indicates a successful or positive action.
                                </div>
                                <span>
                                    09:00 
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-end">
                                <div class="alert alert-secondary message">
                                    Indicates a successful or positive action.
                                </div>
                                <span>
                                    09:00
                                    <i class="bi bi-send-check-fill"></i>
                                    <i class="bi bi-eye-fill"></i>
                                </span>
                            </div>
                        }

                    }
                </div>
                <div class="card-footer d-flex">
                    
                    <button class="btn btn-primary me-2" type="button"><i class="bi bi-emoji-smile"></i></button>
                    <div class="input-group">
                        <textarea class="form-control" placeholder="Write message..." rows="1"></textarea>
                        <button class="btn btn-success" type="button"><i class="bi bi-send"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="chat-section d-none">
    <div class="chat-persons-list active">
        <div class="people-head">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-light rounded-circle" id="toggleTheme" title="Toggle theme"><i class="bi bi-moon-fill"></i></button>
            </div>

            <div class="people-search border rounded-pill">
                <div class="input-group input-group-sm ">
                    <span class="input-group-text bg-transparent border-0"><i class="fa fa-search"></i></span>
                    <input class="form-control form-control-sm rounded-pill border-0" placeholder="Search people" id="searchPeople">
                </div>
            </div>

            <div class="d-flex ms-2 avatar-box">
                <div class="avatar avatar-sm rounded-pill bg-primary text-white d-flex align-items-center justify-content-center profile">VB</div>
            </div>
        </div>

        <div class="list-group list-group-flush" id="peopleListItems" role="tablist">
            @foreach (var user in Model)
            {
                <div class="person d-flex align-items-center" data-name="Maya Patel" data-id="@user.UserId">
                    <div class="avatar bg-info text-white">@user.UserName.FirstOrDefault()</div>
                    <div class="meta">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="name">@user.UserName</div>
                            <div class="muted small">2:18 PM</div>
                        </div>
                        <div class="msg muted"></div>
                    </div>
                </div>
            }
        </div>


        
    </div>
    <div class="chat-window">
        <div class="chat-screen">
            <div class="chat-top">
                <div class="back-btn align-items-center gap-2 ">
                    <button class="btn-minimal btn-minimal-dark"><i class="fa-solid fa-arrow-left"></i></button>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar bg-info text-white d-flex align-items-center justify-content-center">MP</div>
                    <div>
                        <div class="username"></div>
                        <div class="muted small"></div>
                    </div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button class="btn-minimal btn-minimal-dark"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                </div>
            </div>

            <div class="chat-body" id="chatBody">
                <div class="messages" id="messages">

                </div>
            </div>

            <div class="chat-input">
                <div class="input-box">
                    <button class="btn-minimal btn-minimal-dark" id="attachBtn" title="Attach"><i class="fa-solid fa-paperclip"></i></button>
                    <input id="messageInput" placeholder="Type a message" autocomplete="off">
                    <button class="btn-minimal btn-minimal-dark" id="emojiBtn" title="Emoji"><i class="fa-solid fa-face-smile"></i></button>
                </div>
                <button class="btn btn-primary rounded-pill" id="sendBtn">Send</button>
            </div>
        </div>
        <div class="no-chat-screen">
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center gap-3 p-4">
                <div class="avatar avatar-lg bg-primary text-white d-flex align-items-center justify-content-center rounded-circle">💬</div>
                <h4 class="mb-0">Select a chat to start messaging</h4>
                <p class="text-muted">Your conversations will appear here.</p>"
            </div>
        </div>
    </div>
</div>

<script nonce="@Html.ScriptNonce()">
    function chatResize(){
        if(window.innerWidth <= 992){
            resetChatScreen()
        } else{
            $('.no-chat-screen').addClass('active');
            $('.chat-screen').removeClass('active');
            $('.person').removeClass('active');
        }
    }

    $(document).on('DOMContentLoaded', chatResize)
    window.onresize = chatResize;

    function resetChatScreen(){
        $('.chat-persons-list').addClass('active');
        $('.chat-window').removeClass('active');
        $('.chat-screen').removeClass('active');
        $('.no-chat-screen').removeClass('active');
        $('.person').removeClass('active');
    }

    $('.back-btn button').on('click',resetChatScreen);

    $('.person').on('click', function () {
        if($(this).hasClass('active')){
            $('.no-chat-screen').addClass('active');
            $('.chat-screen').removeClass('active');
            $('.person').removeClass('active');
            $(this).removeClass('active');

            return
        }


        $('.chat-window').addClass('active')
        $('.chat-persons-list').removeClass('active')
        $('.person').removeClass('active');
        $(this).addClass('active');
        $('.no-chat-screen').removeClass('active');
        $('.chat-screen').addClass('active');
    });

    $('#sendBtn').on('click', function(){
        const messageInput = $('#messageInput');
        const message = messageInput.val().trim();
        const request = {
            message: message,
            date: new Date().toISOString(),
            userId : $('#peopleListItems .person.active').first().data('id'), // Example: get the first user's ID
            isMe : true
        };
        sendMessage(request);
    });

    function sendMessage(request){
        ajaxPost(
            '@Url.Action("SendMessage", "Chat")',
            request,
            function (result) {
                if(result?.success && result?.data){
                    createMessage(request)
                } else {
                    console.error('Failed to send message:', result?.message);
                }
            },
            { useDefaultSuccessCallBack : false }
        );
    }

    function createMessage(data){
        const message = data.message;
        const user = data.user;
        const time = new Date(data.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        const messageDiv = $(document.createElement('div'));
        messageDiv.addClass('d-flex flex-column').addClass(data.isMe ? 'align-items-end':'');

        const msgContent = document.createElement('div');
        msgContent.classList.add('msg', data.isMe ? 'from-me':'from-them');
        msgContent.textContent = message;
        messageDiv.append(msgContent);

        const timeDiv = $(document.createElement('div'));
        timeDiv.addClass('time muted');
        timeDiv.text(time);
        messageDiv.append(timeDiv);

        $('#messages').append(messageDiv)
        $('#messageInput').val('')
    }

     const connection = new signalR.HubConnectionBuilder()
        .withUrl(resolveSafeUrl(`/hubs/chat`))
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveChatMessage", (response) => {
        if(response?.success && response?.result){
            const result = response.result
            createMessage(result)
            toastr.info(result.message, result.username);
        } else {
            console.error('Failed to fetch message:', result?.message);
        }
    });

    // Start connection
    async function startConnection() {
        try {
            await connection.start();
            console.log("SignalR connected.");
        } catch (err) {
            console.error("Connection failed: ", err);
            setTimeout(startConnection, 5000); // retry
        }
    }

    startConnection();
</script>