@{
    ViewData["Title"] = ViewBag.ModuleTitle;
    ViewData["Module"] = "Maintenance";
    var table = ("Users", "user-table");
}
<style nonce="@Html.ScriptNonce()">
    .name-link{
        text-decoration: none;
        color: black;
        cursor:pointer;
    }
    .name-link:hover{
        text-decoration:underline;
    }
    .tb-action-cell{
        
    }
        .tb-action-cell .tb-action-btn{
            border: none;
            outline: none;
            border-radius: 50%;

        }

    .tb-action-btn.btn-view{
        background: dodgerblue;
        color: white;
    }

    .tb-action-btn.btn-edit {
        background: green;
        color: white;
    }

    .tb-action-btn.btn-del {
        background: red;
        color: white;
    }
</style>

<div class="container-fluid">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h3 class="mt-1">@ViewBag.ModuleTitle</h3>

    <div class="row mb-2">
        <div class="col-12">
            <a href="@Url.Action("CreateUser","Maintenance")" class="btn btn-success btn-sm shadow">Add User</a>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <partial name="Utilities/_Datatables" model="table" />
        </div>
    </div>
</div>
<script nonce="@Html.ScriptNonce()">
    const columns = [
        { property: 'email', displayName: 'Email' },
        { property: 'userName', displayName: 'Username' },
        { property: 'isActive', displayName: 'Active' , type: 'Bool' , render: function(data, type, row) {          
            return getIconElement(data ? 'bi bi-check-circle-fill text-success' : 'bi bi-x-circle-fill text-danger');
        }},
        { property: 'empFullName', displayName: 'Employee Name' , render: function(data, type, row) {
            const notMapped =  document.createElement('span');
            notMapped.className = 'text-secondary';
            notMapped.textContent = 'Not added';

            if(!data || !row.employeeId || isNaN(parseInt(row.employeeId))) return notMapped;

            const anchor = document.createElement('a')
            anchor.href = `@Url.Action("GetEmployeeDetails", "Employee")?employeeId=${row.employeeId}`;
            anchor.className = 'name-link';
            anchor.textContent = data;

            return anchor;
        }},
        { 
            property: 'id', displayName: 'Action', type: 'Number' , searchable : false, className: 'tb-action-cell', sortable: false,
            render: function(data, type, row){
                return `
                    <a href='@Url.Action("ViewUser", "Maintenance")' class='btn btn-sm rounded btn-primary shadow'><i class="bi bi-eye"></i></a>
                    <a href='@Url.Action("UpdateUser", "Maintenance")?id=${data}' class='btn btn-sm rounded btn-success shadow'><i class="bi bi-pencil-square"></i></a>
                    <button class='btn btn-sm rounded btn-danger shadow'><i class="bi bi-trash"></i></button>
                `
            }
        },
    ]

    const adTable = AdvanceSearchTable.create({
        tableSelector: '#user-table',
        ajaxUrl: '@Url.Action("GetUsersMaintenance", "Maintenance")',
        columns: columns,
        dataTableOptions: {
            dom: 'lt'
        }
    })

    $(document).on('click','#user-table-accordion .table-refresh-btn',function(){
        adTable.clearAndReload();
    })
</script>
