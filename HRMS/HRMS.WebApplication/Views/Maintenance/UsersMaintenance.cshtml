@{
    ViewData["Title"] = ViewBag.ModuleTitle;
    ViewData["Module"] = "Maintenance";
    var table = ("Users", "user-table");
}
<style nonce="@Html.ScriptNonce()">
    .name-link{
        text-decoration: none;
        color: black;
        cursor:pointer;
    }
    .name-link:hover{
        text-decoration:underline;
    }

    /* Keep column minimal */
    .tb-action-cell {
        width: .5rem;
        position: relative;
        padding: 0;
    }

        /* Actual action UI */
        .tb-action-cell .actions {
            position: absolute;
            top: 50%;
            right: 0;
            transform: translateY(-50%) scaleX(0);
            transform-origin: right;
            opacity: 0;
            display: flex;
            gap: .5rem;
            transition: transform .3s ease, opacity .15s ease-in-out;
            padding: .3rem;
            border-top-left-radius: 1.5rem;
            border-bottom-left-radius: 1.5rem;
        }

    /* Reveal on row hover / select */
    tr .tb-action-cell:hover .actions,
    tr.selected .tb-action-cell .actions {
        transform: translateY(-50%) scaleX(1);
        opacity: 1;
    }

    tr .tb-action-cell:hover .options,
    tr.selected .tb-action-cell .options {
        opacity: 0;
    }


    .tb-action-btn.btn-view{
        background: dodgerblue;
        color: white;
    }

    .tb-action-btn.btn-edit {
        background: green;
        color: white;
    }

    .tb-action-btn.btn-del {
        background: red;
        color: white;
    }
</style>

<div class="container-fluid">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h3 class="mt-1">@ViewBag.ModuleTitle</h3>

    <div class="row mb-2">
        <div class="col-12">
            <a href="@Url.Action("CreateUser","Maintenance")" class="btn btn-success btn-sm shadow">Add User</a>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <partial name="Utilities/_Datatables" model="table" />
        </div>
    </div>
</div>
<script nonce="@Html.ScriptNonce()">
    const columns = [
        { property: 'email', displayName: 'Email' },
        { property: 'userName', displayName: 'Username' },        
        { property: 'empFullName', displayName: 'Employee Name' , render: function(data, type, row) {
            const notMapped =  document.createElement('span');
            notMapped.className = 'text-secondary';
            notMapped.textContent = 'Not added';

            if(!data || !row.employeeId || isNaN(parseInt(row.employeeId))) return notMapped;

            const anchor = document.createElement('a')
            anchor.href = `@Url.Action("GetEmployeeDetails", "Employee")?employeeId=${row.employeeId}`;
            anchor.className = 'name-link';
            anchor.textContent = data;

            return anchor;
        }},
        { property: 'isActive', displayName: 'Active' , type: 'Bool' , render: function(data, type, row) {
            return getIconElement(data ? 'bi bi-check-circle-fill text-success' : 'bi bi-x-circle-fill text-danger');
        }},
        { 
            property: 'id', displayName: ' ', action: true
        },
    ]

    const adTable = AdvanceSearchTable.create({
        tableSelector: '#user-table',
        ajaxUrl: '@Url.Action("GetUsersMaintenance", "Maintenance")',
        columns: columns,
        dataTableOptions: {
            dom: 'lt'
        },
        actions: {
            enabled: true,
            renderColumn: 'id',

            buttons: {
                view: { enable: true, className: 'bi bi-eye btn btn-sm btn-primary rounded-circle' },
                edit: { enable: true, className: 'bi bi-pencil-square btn btn-sm btn-success rounded-circle' },
                delete: { enable: true, className: 'bi bi-trash btn btn-sm btn-danger rounded-circle' },

                custom: [
                    {
                        name: 'resetPwd',
                        enable: true,
                        render: function (id, row) {
                            return getIconElement('bi bi-airplane-fill btn btn-sm btn-warning rounded-circle');
                        }
                    }
                ]
            }
        }
    })

    $(document).on('click','#user-table-accordion .table-refresh-btn',function(){
        adTable.clearAndReload();
    })
    document.getElementById('user-table')
    .addEventListener('tb.action:edit', function (e) {
        const id = e?.detail?.data?.id;
        if (!id) return;

        const url = new URL(
            '@Url.Action("UpdateUser", "Maintenance")',
            window.location.origin
        );

        url.searchParams.set('id', id);
        window.location.href = url.toString();
    });
    document.getElementById('user-table')
    .addEventListener('tb.action:view', function (e) {
        const id = e?.detail?.data?.id;
        if (!id) return;

        const url = new URL(
            '@Url.Action("ViewUser", "Maintenance")',
            window.location.origin
        );

        url.searchParams.set('id', id);
        window.location.href = url.toString();
    });
</script>
