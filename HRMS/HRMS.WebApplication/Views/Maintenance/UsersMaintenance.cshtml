@{
    ViewData["Title"] = "Users Maintenance";
    ViewData["Module"] = "Maintenance";
    var table = ("Users", "user-table");
}

<div class="container-fluid">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h3 class="mt-1">@ViewData["Title"]</h3>

    <div class="row mb-2">
        <div class="col-12">
            <a href="@Url.Action("CreateUser","Maintenance")" class="btn btn-success btn-sm shadow">Add User</a>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <partial name="Utilities/_Datatables" model="table" />
        </div>
    </div>
</div>
<script nonce="@Html.ScriptNonce()">
    const columns = [
        { property: 'email', displayName: 'Email' },
        { property: 'userName', displayName: 'Username' },
        { property: 'isActive', displayName: 'Active' , type: 'Bool' , render: function(data, type, row) {
            return `<i class="${data ? 'bi bi-check-circle-fill text-success' : 'bi bi-x-circle-fill text-danger'}"></i>`;
        }},
        { property: 'id', displayName: 'Id', type: 'Number' , visible : false },
    ]

    const headerRow = $('#user-table thead tr').empty();
    columns.forEach(x => {
        const elem = document.createElement('th');
        if(x.visible === false)
            elem.textContent =  (x.displayName || x.property);
        headerRow.append(elem)
    })

    const adTable = new AdvanceSearchTable({
        tableSelector: '#user-table',
        filterSelector: '#search-box-user-table',
        ajaxUrl: '@Url.Action("GetUsersMaintenance","Maintenance")',
        columns: columns,
        dataTableOptions: {
            dom: 'lt'
        }
    })

    $(document).on('click','#accordion-user-table .table-refresh-btn',function(){

        adTable.refresh();
    })
</script>
