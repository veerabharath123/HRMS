@model UserDetailsResponseDto

<div class="mt-3 form-control-section">
    <label for="username" class="form-label">Username:</label>
    <input type="text" class="form-control form-control-sm" id="username" placeholder="Enter Username" asp-for="UserName">
    <span class="invalid-feedback"></span>
</div>
<div class="form-control-section">
    <label for="email" class="form-label">Email:</label>
    <input type="text" class="form-control form-control-sm" id="email" placeholder="Enter Email" asp-for="Email">
    <span class="invalid-feedback"></span>
</div>