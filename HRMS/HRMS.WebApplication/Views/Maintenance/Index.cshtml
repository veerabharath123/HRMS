@model List<ModulesResponseDto>
@{
    ViewData["Title"] = ViewBag.ModuleTitle;
    ViewData["Module"] = ViewBag.ModuleTitle;
}
<style nonce="@Html.ScriptNonce()">
    .maintenance-card{
        
    }
    .maintenance-card-content{
        text-decoration: none;
        color: black;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
    .maintenance-card .card-body{
        display:flex;
        flex-direction: column;
        justify-content:center;
        align-items:center;
        cursor: pointer;
    }

    .maintenance-card .card-body i{
        font-size: 3rem;
    }
</style>

<div class="container-fluid h-100">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h3 class="mt-1">@ViewBag.ModuleTitle</h3>

    <div class="row maintenance-block mt-3">
        @foreach (var item in Model)
        {
            <div class="col-lg-2 col-md-3 col-6 mb-2">
                <div class="card shadow maintenance-card h-100">
                    <div class="card-body">
                        <a href="@Url.Action(item.Action, item.Controller)" class="maintenance-card-content">
                            <i class="@item.IconName"></i>
                            <span class="ms-2">@item.Name</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
