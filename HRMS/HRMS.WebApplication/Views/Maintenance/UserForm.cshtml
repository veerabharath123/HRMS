@model UserFormVm

@{
    ViewData["Title"] = ViewBag.ModuleTitle;
    ViewData["Module"] = "Maintenance";
}

<div class="container-fluid">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h2 class="mt-1">@ViewBag.ModuleTitle</h2>

    <form id="user-form">
        <div class="row">
            <div class="col-sm-12 col-md-6 col-lg-4">
                <div class="card shadow">
                    <div class="card-body">

                        <input type="hidden" id="formMode" asp-for="Mode" />

                        <div class="mt-3 form-control-section"> 
                            <label for="username" class="form-label">Username:</label> 
                            <input type="text" class="form-control form-control-sm" id="username" placeholder="Enter Username" asp-for="UserDetails.UserName" name="UserName" asp-readonly="Model.IsReadOnly">
                            <span class="invalid-feedback"></span> 
                        </div> 
                        <div class="form-control-section"> 
                            <label for="email" class="form-label">Email:</label> 
                            <input type="text" class="form-control form-control-sm" id="email" placeholder="Enter Email" asp-for="UserDetails.Email" name="Email" asp-readonly="Model.IsReadOnly">
                            <span class="invalid-feedback"></span> 
                        </div>

                        @if (Model.ShowPassword)
                        {
                            <div class="form-control-section">
                                <label class="form-label">Password:</label>
                                <div class="input-group input-group-sm password-toggle">
                                    <input type="password" class="form-control form-control-sm" id="password" name="Password">
                                    <span class="input-group-text toggle-password cursor-pointer">
                                        <i class="bi bi-eye"></i>
                                    </span>
                                </div>
                                <span class="invalid-feedback"></span>
                            </div>

                            <div class="form-control-section">
                                <label class="form-label">Confirm Password:</label>
                                <div class="input-group input-group-sm password-toggle">
                                    <input type="password" class="form-control form-control-sm" id="confim-password" name="ConfirmPassword">
                                    <span class="input-group-text toggle-password cursor-pointer">
                                        <i class="bi bi-eye"></i>
                                    </span>
                                </div>
                                <span class="invalid-feedback"></span>
                            </div>
                        }

                        @if (Model.CanSubmit)
                        {
                            <button type="submit" class="btn btn-sm btn-primary mt-3">
                                @(Model.Mode == FormMode.Add ? "Create" : "Update")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>

    <script nonce="@Html.ScriptNonce()">
        $(document).on('click', '.toggle-password', function () {
            const $wrapper = $(this).closest('.password-toggle');
            const $input = $wrapper.find('input');

            const isPassword = $input.attr('type') === 'password';

            // Toggle input type
            $input.attr('type', isPassword ? 'text' : 'password');

            // Toggle icon
            const $icon = $(this).find('i');
            $icon.toggleClass('bi-eye bi-eye-slash');
        });

        const mode = $('#formMode').val()?.toUpperCase();

        const rules = {
            UserName: { required: true, minLength: 3 },
            Email: { required: true, email: true }
        };

        if (mode === 'ADD') {
            rules.Password = { required: true, minLength: 6 };
            rules.ConfirmPassword = { required: true, minLength: 6, match: 'Password', notMapped: true };
        }

        const userForm = FormBuilder.create('#user-form', {
            builder: rules,
            messages:{ ConfirmPassword: { match: 'Passwords do not match' } },
            live: true
        });

        userForm.onSubmit(function(isvalid){
            if (!isvalid || mode === 'VIEW') return;

            ajaxPost(
                '@Model.SubmitUrl',
                userForm.getValueJson(),
                function (res) {
                    if(!res?.success){
                        showNotification({
                            type: 'error',
                            message: res?.message || 'Something went wrong!',
                        });
                    }

                    showNotification({
                        type: 'success',
                        message: res?.message || 'Something went wrong!',
                        onComplete: () => window.location.href = res.redirectTo
                    });
                }
                ,{ contentType: "application/json", processData: false, useDefaultSuccessCallBack: false }
            );
        });

    </script>

</div>