@{
    ViewData["Title"] = ViewBag.ModuleTitle;
    ViewData["Module"] = "Maintenance";
}
<style nonce="@Html.ScriptNonce()">
    .password-toggle > span {
        cursor:pointer;
    }
    .password-toggle > span:active > i {
        transform: scale(.9)
    }
    .form-control-section .invalid-feedback {
        height: 1rem;
        margin-top: .0px !important;
    }
    .form-control-section.has-error {
        margin:0 !important
    }
    .form-control-section::after{
        content: '.';
        height: 1rem;
        display:block;
        visibility:hidden;
    }
    .form-control-section.has-error::after {
        height: 0px !important;
    }
</style>

<div class="container-fluid">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h2 class="mt-1">@ViewBag.ModuleTitle</h2>

    <form id="user-form"> 
        <div class="row">
            <div class="col-sm-12 col-md-6 col-lg-4">
                <div class="card shadow">
                    <div class="card-body">
                        <h5>User Info</h5>
                        <hr />

                        <div class="mt-3 form-control-section">
                            <label for="username" class="form-label">Username:</label>
                            <input type="text" class="form-control form-control-sm" id="username" placeholder="Enter Username" name="UserName">
                            <span class="invalid-feedback"></span>
                        </div>
                        <div class="form-control-section">
                            <label for="email" class="form-label">Email:</label>
                            <input type="text" class="form-control form-control-sm" id="email" placeholder="Enter Email" name="Email">
                            <span class="invalid-feedback"></span>
                        </div>
                        <div class=" form-control-section">
                            <label for="password" class="form-label">Password:</label>
                            <div class="input-group password-toggle">
                                <input type="password" class="form-control form-control-sm" id="password" placeholder="Enter Password" name="Password">

                                <span class="input-group-text toggle-password">
                                    <i class="bi bi-eye"></i>
                                </span>
                            </div>
                            <span class="invalid-feedback"></span>
                        </div>
                        <div class="form-control-section">
                            <label for="confim-password" class="form-label">Confirm Password:</label>
                            
                            <div class="input-group password-toggle">
                                <input type="password" class="form-control form-control-sm" id="confim-password" placeholder="Enter Confirm Password" name="ConfirmPassword">

                                <span class="input-group-text toggle-password cursor-pointer">
                                    <i class="bi bi-eye"></i>
                                </span>
                            </div>
                            <span class="invalid-feedback"></span>
                        </div>

                        <button type="submit" class="btn btn-sm btn-primary mt-3">Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    
    <script nonce="@Html.ScriptNonce()" >
        $(document).on('click', '.toggle-password', function () {
            const $wrapper = $(this).closest('.password-toggle');
            const $input = $wrapper.find('input');

            const isPassword = $input.attr('type') === 'password';

            // Toggle input type
            $input.attr('type', isPassword ? 'text' : 'password');

            // Toggle icon
            const $icon = $(this).find('i');
            $icon.toggleClass('bi-eye bi-eye-slash');
        });

        const userForm = FormBuilder.create('#user-form', {
            builder:{
                UserName: { required: true, minLength: 3 },
                Password: { required: true, minLength: 6 },
                ConfirmPassword: { required: true, minLength: 6, match: 'Password',notMapped: true },
                Email: { required: true, email: true },
            },
            messages:{
                ConfirmPassword: { match: 'Passwords do not match' }
            },
            live: true
        });

        userForm.onSubmit(function(isvalid){
            if (!isvalid) return

            ajaxPost(
                '@Url.Action("SaveUser", "Maintenance")',
                userForm.getValueJson(),
                function (res) {
                    if(!res?.success){
                        showNotification({
                            type: 'error',
                            message: res?.message || 'Something went wrong!',
                        });
                    }

                    showNotification({
                        type: 'success',
                        message: res?.message || 'Something went wrong!',
                        onComplete: () => window.location.href = res.redirectTo
                    });
                }
                ,{ contentType: "application/json", processData: false, useDefaultSuccessCallBack: false }
            );
        });        

    </script>
    
</div>