@{
    ViewData["Title"] = "Home Page";
    (string, string) tableModel = ("Index Table", "index-table");
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    
    <a href="@Url.Action("GetDocument","Home")" target="_blank">Download</a>
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                @* <form method="post" asp-controller="Home" asp-action="UploadDocument" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="fileInput">Upload Document:</label>
                        <input type="file" class="form-control" id="fileInput" name="file" />
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Upload</button>
                </form> *@

                <form id="msg">
                    <div class="form-group">
                        <label for="username">Username:</label>
                        <input type="text" class="form-control" id="username" name="Username" />
                    </div>
                    <div class="form-group">
                        <label for="message">Message:</label>
                        <textarea class="form-control" id="message" name="Message" placeholder="Message"></textarea>
                    </div>
                    <button type="submit" class="btn btn-sm btn-success">Send</button>
                </form>
            </div>
        </div>
    </div>
    <ul id="notify-list">
        
    </ul>
    <partial name="Datatables" model="tableModel" />
</div>

<script nonce="@Html.ScriptNonce()">

    $('#msg').on('submit', function(e) {
        e.preventDefault();
        const username = $('#username').val();
        const title = '@User.Identity.Name';
        const message = $('#message').val();
        if (username && title && message) {
           $.ajax({
               url: '@Url.Action("SendMessage", "Home")',
                type: 'POST',
                data: { Username: username, Title: title, Message: message },
                success: function(response) {
                    if(response?.success) {
                        const li = document.createElement("li");
                        li.textContent = `$Me: ${message}`;
                        $('#notify-list').append(li);
                    } else {
                        alert('Failed to send message');
                    }
                },
           })
        }
        return false
    });

    const table = new AdvanceSearchTable({
        tableSelector: "#index-table",
        filterSelector: "#search-box-index-table",
        ajaxUrl: '@Url.Action("GetDatatables","Home")',
        columns: [
            { property: 'name' , type: 'text' },
            { property: 'age' , type: 'number' },
            { property: 'birthdate' , type: 'date' },
            { property: 'timer' , type: 'time' },
            { property: 'active' , type: 'bool' },
        ],
        dataTableOptions: {
            pageLength: 10,
            ordering: true,
            searching: false,
            select: true
        }
    });
  

        const connection = new signalR.HubConnectionBuilder()
        .withUrl(`${window.basePath}/hubs/notification`) // Proxy endpoint, not backend URL
        .withAutomaticReconnect()
        .build();

    // Receive notification
    connection.on("ReceiveNotification", (title, body) => {
        console.log("Notification:", title, body);

        // Example: show in UI
        const li = document.createElement("li");
        li.textContent = `${title}: ${body}`;
        $('#notify-list').append(li);
    });

    connection.on("ReceiveNotifications", (title, body) => {
        console.log("Notification all:", title, body);
    });

    // Start connection
    async function startConnection() {
        try {
            await connection.start();
            console.log("SignalR connected.");
        } catch (err) {
            console.error("Connection failed: ", err);
            setTimeout(startConnection, 5000); // retry
        }
    }

    startConnection();
</script>
