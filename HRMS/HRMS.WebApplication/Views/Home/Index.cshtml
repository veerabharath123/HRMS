@{
    ViewData["Title"] = "Dashboard";
    ViewData["Module"] = "Dashboard";
    //(string, string) tableModel = ("Index Table", "index-table");
}

<script src="https://cdn.jsdelivr.net/npm/chart.js" nonce="@Html.ScriptNonce()"></script>
<style nonce="@Html.ScriptNonce()">
    .chart-container {
        width: 100%;
        max-width: 100%;
        overflow: hidden; /* prevents x-scroll */
    }

    canvas {
        display: block;
        max-width: 100% !important;
        width: 100% !important;
    }
</style>

<div class="container-fluid chart-container">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h3 class="mt-1">@ViewData["Module"]</h3>

    <div class="row mt-3">
        <div class="col-lg-6 col-sm-12 mb-3">
            <div class="card shadow">
                <div class="card-body">
                    <canvas id="myChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-12 mb-3">
            <div class="row">
                <div class="col-md-6 col-12 mb-3">
                    <div class="card shadow">
                        <div class="card-body">
                            <canvas id="donutChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-12 mb-3">
                    <div class="card shadow">
                        <div class="card-body">
                            <canvas id="donutChart2"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



<script nonce="@Html.ScriptNonce()">

    const ctx = document.getElementById('myChart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],
            datasets: [{
                label: '# of Votes',
                data: [12, 19, 3, 5, 2, 3],
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            },
            responsive: true,
            maintainAspectRatio: false                  
        }
    });

    const ctx1 = document.getElementById('donutChart');

    new Chart(ctx1, {
        type: 'doughnut',
        data: {
            labels: ['Active', 'Inactive', 'Pending'],
            datasets: [{
                data: [60, 25, 15],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            },
            maintainAspectRatio: false
        }
    });

    $('#exampleModal #upload').on('file:upload', function(e, res){
        console.log(e , res.files)
    })

    $('#msg').on('submit', function(e) {
        e.preventDefault();
        const username = $('#username').val();
        const title = '@User.Identity?.Name';
        const message = $('#message').val();

        if (username && title && message) {
            ajaxPost(
                '@Url.Action("SendMessage", "Home")',
                { Username: username, Title: title, Message: message },
                function(response) {
                    if(response?.success) {
                        const li = document.createElement("li");
                        li.textContent = `$Me: ${message}`;
                        $('#notify-list').append(li);
                    } else {
                        alert('Failed to send message');
                    }
                }
            )
        }
        return false
    });

    const table = new AdvanceSearchTable({
        tableSelector: "#index-table",
        filterSelector: "#search-box-index-table",
        ajaxUrl: '@Url.Action("GetDatatables","Home")',
        columns: [
            { property: 'name' , type: 'text' },
            { property: 'age' , type: 'number' },
            { property: 'birthdate' , type: 'date' },
            { property: 'timer' , type: 'time' },
            { property: 'active' , type: 'bool' },
        ],
        dataTableOptions: {
            pageLength: 10,
            ordering: true,
            searching: false,
            select: true
        }
    });
  

    const connection = new signalR.HubConnectionBuilder()
        .withUrl(resolveSafeUrl('/hubs/notification')) 
        .withAutomaticReconnect()
        .build();

    // Receive notification
    connection.on("ReceiveNotification", (title, body) => {
        console.log("Notification:", title, body);

        // Example: show in UI
        const li = document.createElement("li");
        li.textContent = `${title}: ${body}`;
        $('#notify-list').append(li);
    });

    connection.on("ReceiveNotifications", (title, body) => {
        console.log("Notification all:", title, body);
    });

    // Start connection
    async function startConnection() {
        try {
            await connection.start();
            console.log("SignalR connected.");
        } catch (err) {
            console.error("Connection failed: ", err);
            setTimeout(startConnection, 5000); // retry
        }
    }

    startConnection();
</script>
