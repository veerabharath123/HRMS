    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" nonce="@Html.ScriptNonce()" />
    <script src="~/lib/jquery/dist/jquery.min.js" nonce="@Html.ScriptNonce()"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" nonce="@Html.ScriptNonce()"></script>
    <link href="~/css/site.css" rel="stylesheet" nonce="@Html.ScriptNonce()" />
    <style nonce="@Html.ScriptNonce()">
        body, html {
            height: 100%;
            margin: 0;
        }

        .bg-image {
            background: url('@Url.Content("/images/bg-light.jpg")') no-repeat center center/cover;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 1rem;
            box-shadow: 0 4px 30px rgba(0,0,0,0.1);
            padding: 2rem;
            width: 100%;
            max-width: 400px;
            margin: 2rem;
            color: #2d2d2d;
        }

        .form-control {
            background: #cfcfcf82;
            border: none;
            color: #2d2d2d;
        }

            .form-control:focus {
                background: #cfcfcf82;
                box-shadow: none;
                color: #2d2d2d;
            }

            .form-control::placeholder {
                color: #00000085;
            }

        .btn-primary {
            background: #0d6efd;
            border: none;
        }

        /* Responsive: center card on small screens */
        @@media (max-width: 768px) {
            .bg-image {
                justify-content: center;
            }
        }

        /* 🌙 Dark mode styles */
        @@media (prefers-color-scheme: dark) {
            .bg-image {
                background: url('@Url.Content("/images/bg-dark.jpg")') no-repeat center center/cover;
            }

            .glass-card {
                background: rgba(0, 0, 0, 0.4);
                color: #f1f1f1;
            }

            .form-control {
                background: rgba(255, 255, 255, 0.1);
                color: #f1f1f1;
            }

                .form-control:focus {
                    background: rgba(255, 255, 255, 0.15);
                    color: #fff;
                }

                .form-control::placeholder {
                    color: #bbb;
                }

            .logo {
                border: 2px solid #ffffff82;
            }
        }

        .logo {
            aspect-ratio: 1/1;
            width: 50px;
            margin: .5rem auto;
            border-radius: 50%;
            border: 2px solid #2b2b2b;
            padding: 1px;
        }

        .logo-block {
            text-align: center
        }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
