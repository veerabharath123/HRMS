<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRMS - 404 Not Found</title>
    <style>
        /* --- CSS Variables & Theming --- */
        :root {
            --bg-color: #f4f7fa;
            --card-bg: #ffffff;
            --text-main: #1f2937;
            --text-sub: #6b7280;
            --accent-color: #3b82f6;
            --accent-hover: #2563eb;
            --border-radius: 12px;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --bg-color: #111827;
                --card-bg: #1f2937;
                --text-main: #f3f4f6;
                --text-sub: #9ca3af;
                --accent-color: #60a5fa;
                --accent-hover: #93c5fd;
                --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
            }
        }

        /* --- Reset & Layout --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* --- Main Card --- */
        .error-container {
            background-color: var(--card-bg);
            padding: 3rem 2rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            text-align: center;
            max-width: 480px;
            width: 90%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }

        /* --- Image Placeholder --- */
        .illustration-wrapper {
            width: 100%;
            max-width: 300px;
            height: auto;
            margin-bottom: 0.5rem;
            border-radius: 8px;
            overflow: hidden;
        }

            .illustration-wrapper img {
                width: 100%;
                height: auto;
                display: block;
                object-fit: contain;
            }

        /* --- Typography --- */
        h1 {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -0.025em;
        }

        p {
            color: var(--text-sub);
            font-size: 1rem;
            line-height: 1.5;
        }

        /* --- Button --- */
        .btn-dashboard {
            margin-top: 1rem;
            display: inline-block;
            background-color: var(--accent-color);
            color: #ffffff;
            text-decoration: none;
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.95rem;
            transition: background-color 0.2s ease, transform 0.1s ease;
            cursor: pointer;
        }

            .btn-dashboard:hover {
                background-color: var(--accent-hover);
            }

            .btn-dashboard:active {
                transform: scale(0.98);
            }
    </style>
</head>
<body>

    <main class="error-container">
        <div class="illustration-wrapper">
            <img src="path_to_404_image.png" alt="HR Page Not Found Illustration">
        </div>

        <h1>Page not found</h1>

        <p>We couldn't find the page you were looking for. It may have been moved, renamed, or deleted.</p>

        <a href="/dashboard" id="return-btn" class="btn-dashboard">Go back</a>
    </main>

    <script >
        document.getElementById('return-btn').addEventListener('click', function(event) {
            if (window.history.length > 1) {
                event.preventDefault();
                window.history.back();
            }
        });
    </script>
</body>
</html>