@{
    var currentModule = $"{ViewData["Module"]}";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRMS Dashboard</title>
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"> *@
    @* <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script> *@
    @* <script src="https://cdn.jsdelivr.net/npm/chart.js" ></script> *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" nonce="@Html.ScriptNonce()" />

    <link rel="stylesheet" href="~/HRMS.WebApplication.styles.css" asp-append-version="true" nonce="@Html.ScriptNonce()" />
    <script src="~/lib/jquery/dist/jquery.min.js" nonce="@Html.ScriptNonce()"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" nonce="@Html.ScriptNonce()"></script>
    <link href="https://cdn.datatables.net/2.3.3/css/dataTables.bootstrap5.min.css" rel="stylesheet" nonce="@Html.ScriptNonce()" />
    <script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js" nonce="@Html.ScriptNonce()"></script>
    <script src="https://cdn.datatables.net/2.3.3/js/dataTables.bootstrap5.min.js" nonce="@Html.ScriptNonce()"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" nonce="@Html.ScriptNonce()" />
    <script src="~/lib/microsoft-signalr/signalr.min.js" nonce="@Html.ScriptNonce()"></script>
    <script src="~/js/advance.search.table.js" nonce="@Html.ScriptNonce()"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" nonce="@Html.ScriptNonce()" />
    <style nonce="@Html.ScriptNonce()">
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            height: 56px;
            z-index: 1050;
        }

        /* Sidebar */
        .sidebar {
            width: 220px;
            height: calc(100vh - 56px);
            position: fixed;
            top: 56px;
            left: 0;
            background-color: white;
            padding-top: 1rem;
            transition: width 0.3s, left 0.3s;
            overflow-x: hidden;
            white-space: nowrap;
            z-index: 1040; /* ensure it's above content */
            box-shadow: 2px .5rem 12px 2px #00000017;
        }

            .sidebar.collapsed {
                width: 70px;
            }

            .sidebar .nav-link {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 0.75rem 1rem;
                border-radius: .5rem;
                transition: all 0.3s;
                color: var(--bs-body-color);
            }

                .sidebar .nav-link span {
                    transition: opacity 0.3s;
                }

            .sidebar.collapsed .nav-link.active {
                width:53px
            }

            .sidebar.collapsed .nav-link span {
                opacity: 0;
                visibility: hidden;
            }

            .sidebar .nav-link.active {
                background-color: var(--bs-primary);
                color: #fff;
            }

        /* Content */
        .content {
            margin-left: 220px;
            padding: 1.5rem;
            margin-top: 56px;
            flex: 1;
            transition: margin-left 0.3s;
        }

            .content.expanded {
                margin-left: 70px;
            }

        /* Mobile behavior */
        @@media (max-width: 768px) {
            .sidebar

        {
            left: -220px;
        }

        .sidebar.show {
            left: 0;
        }

        .content {
            margin-left: 0 !important;
            overflow:auto
        }

        }

        /* Navbar collapse background */
        .navbar-collapse {
            background: var(--bs-body-bg);
            padding: 0.5rem;
            border-radius: 0.5rem;
        }
    </style>
</head>
<body>
    <script nonce="@Html.ScriptNonce()">
        window.basePath = '@(Context.Request.PathBase.Value)';
    </script>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-body-tertiary shadow-sm fixed-top">
        <div class="container-fluid">
            <button class="btn btn-outline-primary me-2" id="sidebarToggle"><i class="fas fa-bars"></i></button>
            <a class="navbar-brand fw-bold" href="#">HRMS</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse mt-2 mt-lg-0" id="topNav">
                <form class="d-flex ms-auto my-2 my-lg-0" role="search">
                    <input class="form-control me-2" type="search" placeholder="Search...">
                    <button class="btn btn-outline-primary" type="submit">Search</button>
                </form>
                <ul class="navbar-nav ms-3">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                            <img src="" class="rounded-circle me-2" alt="Profile">
                            <span>Admin</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="@Url.Action("Logout","Login")">Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <div class="sidebar collapsed d-flex flex-column p-2" id="sidebarMenu">
        <ul class="nav nav-pills flex-column">
            <li class="nav-item"><a href="@Url.Action("Index", "Home")" class="nav-link @(currentModule == "Home" ? "active" : "")"><i class="fas fa-chart-line"></i> <span>Dashboards</span></a></li>
            <li class="nav-item">
                <a href="@Url.Action("Chats", "Chat")" class="nav-link @(currentModule == "Chats" ? "active" : "")"><i class="fa-solid fa-message"></i> <span>Chats</span></a>
            </li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-users"></i> <span>Employees</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-calendar-alt"></i> <span>Leave Management</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-money-bill"></i> <span>Payrolls</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-cogs"></i> <span>Admin</span></a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <main class="content expanded" id="mainContent">
        @RenderBody()
    </main>

    <script defer nonce="@Html.ScriptNonce()">
        const sidebar = $('#sidebarMenu');
        const content = $('#mainContent');
        const toggleBtn = $('#sidebarToggle');

        toggleBtn.on('click', () => {
            if (window.innerWidth > 768) {
                const isCollapsed = sidebar.hasClass('collapsed');

                sidebar.removeClass('collapsed show');
                content.removeClass('expanded');

                if(!isCollapsed){
                    sidebar.addClass('collapsed');
                    content.addClass('expanded');
                }

                localStorage.setItem("sidebar-collapsed", !isCollapsed);
            } else {
                sidebar.removeClass('collapsed');
                content.removeClass('expanded').addClass('expanded');
                sidebar.toggleClass('show');
            }

            
        });

        // // Charts
        // new Chart(document.getElementById('lineChart'), {
        //   type: 'line',
        //   data: {
        //     labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May'],
        //     datasets: [{ label: 'Employees', data: [50, 60, 70, 90, 120], borderColor: 'blue', fill: false }]
        //   }
        // });

        // new Chart(document.getElementById('barChart'), {
        //   type: 'bar',
        //   data: {
        //     labels: ['Sick Leave', 'Casual Leave', 'Earned Leave'],
        //     datasets: [{ label: 'Count', data: [12, 19, 7], backgroundColor: ['#0d6efd', '#198754', '#ffc107'] }]
        //   }
        // });

        // Restore collapse state on page load
        $(document).on("DOMContentLoaded", () => {
            const isCollapsed = localStorage.getItem("sidebar-collapsed") === "true";

            sidebar.removeClass("collapsed show")
            content.removeClass('expanded')

            if (isCollapsed && window.innerWidth > 768) {
                sidebar.addClass("collapsed")
                content.addClass('expanded');
            }
        });
    </script>
</body>
</html>
