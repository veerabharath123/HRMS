@model (string title, string selector)

<div>
    <div id="accordion-@Model.selector" class="bg-white rounded shadow p-4 w-100">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1"><h2 class="my-1 text-start">@Model.title</h2></div>
            <div class="">
                <a class="btn btn-sm bg-light text-secondary border border-secondary">
                    <i class="fa-solid fa-rotate-right"></i>
                </a>
                <a class="btn btn-sm bg-light text-secondary border border-secondary" data-bs-toggle="collapse" href="#collapseOne-@Model.selector">
                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                </a>
                <a class="btn btn-sm bg-light text-secondary border border-secondary" data-bs-toggle="collapse" href="#collapse2-@Model.selector">
                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                </a>
            </div>
        </div>

        <div id="collapseOne-@Model.selector" class="collapse" data-bs-parent="#accordion-@Model.selector">
            <hr class="mb-1 mt-1" />
            <div id="search-box-@Model.selector">
                <!-- Search row template, the library will manage its content -->
                <div class="advance-search-row row g-3 align-items-center mb-3">
                    <!-- Field Selection -->
                    <div class="col-md">
                        <label class="form-label">Field</label>
                        <select class="fields form-select form-select-sm border rounded shadow-sm"></select>
                    </div>
                    <!-- Operator Selection -->
                    <div class="col-md">
                        <label class="form-label">Operator</label>
                        <select class="operator form-select form-select-sm border rounded shadow-sm"></select>
                    </div>
                    <!-- Comparator Selection -->
                    <div class="col-md">
                        <label class="form-label">Comparator</label>
                        <select class="comparator form-select form-select-sm border rounded shadow-sm"></select>
                    </div>
                    <!-- Target Value Input -->
                    <div class="col-md">
                        <label class="form-label">Value</label>
                        <div class="target"></div>
                    </div>
                    <!-- Action Buttons -->
                    <div class="col-md-auto">
                        <label class="form-label">Action</label>
                        <div class="col-12 d-flex align-items-center flex-wrap">
                            <button class="add-btn btn btn-primary btn-sm me-2 rounded-pill">
                                Add
                            </button>
                            <button class="del-btn btn btn-danger btn-sm rounded-pill" disabled>
                                Del
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-lg-end justify-content-md-center">
                <div class="col-auto">
                    <button id="searchButton-@Model.selector" class="mt-4 btn btn-primary rounded shadow-md fw-bold rounded-pill advance-serach-btn">
                        Search
                    </button>
                    <button id="clearSearchButton-@Model.selector" class="mt-4 btn btn-warning rounded shadow-md fw-bold rounded-pill advance-serach-clear-btn">
                        Clear
                    </button>
                </div>
            </div>
            <hr class="mb-2 mt-2" />
        </div>
        <div id="collapse2-@Model.selector" class="collapse" data-bs-parent="#accordion-@Model.selector">
            <div class="row mt-3">
                <div class="col-3"><input type="text" class="form-control form-control-sm" /></div>
                <div class="col-3 text-start">
                    <button class="btn btn-sm bg-light text-secondary border border-secondary text-dark">search</button>
                </div>
            </div>
        </div>


        <div class="w-100 mt-4">
            <div class="table-responsive">
                <table id="@Model.selector" class="table w-100">
                    <thead class="table-white table-bordered">
                        <tr>
                            <th>name</th>
                            <th>age</th>
                            <th>birthdate</th>
                            <th>timer</th>
                            <th>active</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

    </div>
</div>


