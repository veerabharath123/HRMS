<div class="image-previewer-container">
    <div class="preview-image-section d-center">
        <img class="preview-image" alt="no-image" src="~/images/hrms-error-img.png" />
    </div>
    <div class="image-btn-section">
        <button class="btn btn-sm btn-outline-dark zoomOutBtn d-none">
            <i class="bi bi-zoom-out"></i>
        </button>

        <button class="btn btn-sm btn-outline-dark zoomInBtn d-none">
            <i class="bi bi-zoom-in"></i>
        </button>

        <button class="btn btn-sm btn-outline-dark resetZoomBtn">
            <i class="bi bi-arrow-counterclockwise"></i>
        </button>

        <a class="downloadAttachmentBtn btn btn-sm btn-outline-dark d-none"
           download>
            <i class="bi bi-download"></i>
        </a>
    </div>
</div>