@model (string title, string selector)
<style nonce="@Html.ScriptNonce()">
    .advance-search-container, .simple-search-container{
        padding: 1rem;
        background: rgba(211, 211, 211, 0.34);
        max-height: 20rem;
        overflow-y: auto;
        overflow-x: clip;
    }
    .m-table{
        /* margin-left:.7rem;
        margin-right:.7rem; */
    }
</style>
<div>
    <div id="@(Model.selector)-accordion" class="bg-white rounded shadow p-3 w-100 advance-search-table-container">
        <div class="d-flex align-items-center mb-3 m-table">
            <div class="flex-grow-1"><h5 class="my-1 text-start">@Model.title</h5></div>
            <div class="gap-3">
                <a class="btn btn-sm btn-primary table-refresh-btn">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="collapse" href="#@(Model.selector)-simple-search-container">
                        <i class="bi bi-search"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="collapse" href="#@(Model.selector)-advance-search-container">
                        <i class="bi bi-search"></i><i class="bi bi-plus"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="@(Model.selector)-advance-search-container" class="collapse advance-search-container rounded m-table" data-bs-parent="#@(Model.selector)-accordion">
            <div id="@(Model.selector)-search-box">
                <!-- Search row template, the library will manage its content -->
                <div class="advance-search-row row g-3 align-items-center mb-3">
                    <!-- Operator Selection -->
                    <div class="col-md">
                        <label class="form-label">Operator</label>
                        <select class="operator form-select form-select-sm border rounded shadow-sm"></select>
                    </div>
                    <!-- Field Selection -->
                    <div class="col-md">
                        <label class="form-label">Field</label>
                        <select class="fields form-select form-select-sm border rounded shadow-sm"></select>
                    </div>                   
                    <!-- Comparator Selection -->
                    <div class="col-md">
                        <label class="form-label">Comparator</label>
                        <select class="comparator form-select form-select-sm border rounded shadow-sm"></select>
                    </div>
                    <!-- Target Value Input -->
                    <div class="col-md">
                        <label class="form-label">Value</label>
                        <div class="target"></div>
                    </div>
                    <!-- Action Buttons -->
                    <div class="col-md-auto">
                        <label class="form-label">Action</label>
                        <div class="col-12 d-flex align-items-center flex-wrap gap-2">
                            <div class="btn-group">
                                <button class="add-btn btn btn-primary btn-sm" type="button">
                                    Add
                                </button>
                                
                                <button class="del-btn btn btn-danger btn-sm" type="button" disabled>
                                    Del
                                </button>
                                
                            </div>
                            <button class="clear-btn btn btn-info btn-sm" type="button"> 
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-lg-end justify-content-md-center">
                <div class="col-auto">
                    <button id="@(Model.selector)-clearSearchButton" class="mt-4 btn btn-info rounded shadow-md fw-bold advance-serach-clear-btn">
                        Clear All
                    </button>
                    <button id="@(Model.selector)-searchButton" class="mt-4 btn btn-success rounded shadow-md fw-bold advance-serach-btn">
                        Search
                    </button>
                </div>
            </div>
        </div>
        <div id="@(Model.selector)-simple-search-container" class="collapse mt-3 simple-search-container rounded" data-bs-parent="#@(Model.selector)-accordion">
            <div class="row">
                <div class="col-3"><input type="text" class="form-control form-control-sm" placeholder="Search"/></div>
                <div class="col text-start gap-3">
                    <button class="clear-btn btn btn-info btn-sm" type="button">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button class="btn btn-sm btn-success simple-search-btn">search</button>
                </div>
            </div>
        </div>


        <div class="w-100 mt-3">
            <div class="table-responsive">
                <table id="@Model.selector" class="table w-100">
                    <thead class="table-white">
                        <tr>
                            <th>name</th>
                            <th>age</th>
                            <th>birthdate</th>
                            <th>timer</th>
                            <th>active</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col" id="@(Model.selector)-pagination">
            </div>
        </div>

    </div>
</div>

