@model IPaginationResponseDto
@{
    var page = Model.PageNumber;
    var totalPages = Model.TotalPages;
}
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-start">

        <!-- Start -->
        <li class="page-item @(page == 1 ? "disabled" : "")">
            <a class="page-link page-nav" data-page="1"><i class="bi bi-chevron-double-left"></i></a>
        </li>

        <!-- Previous -->
        <li class="page-item @(page == 1 ? "disabled" : "")">
            <a class="page-link page-nav" data-page="@(page - 1)">Previous</a>
        </li>

        <!-- Page Numbers -->
        @for (int i = Model.FirstPageToShow; i <= Model.LastPageToShow; i++)
        {
            <li class="page-item @(i == page ? "active" : "")">
                <a class="page-link page-nav" data-page="@i">@i</a>
            </li>
        }

        <!-- Next -->
        <li class="page-item @(page == totalPages ? "disabled" : "")">
            <a class="page-link page-nav" data-page="@(page + 1)">Next</a>
        </li>

        <!-- End -->
        <li class="page-item @(page == totalPages ? "disabled" : "")">
            <a class="page-link page-nav" data-page="@totalPages" href="#"><i class="bi bi-chevron-double-right"></i></a>
        </li>
    </ul>
</nav>