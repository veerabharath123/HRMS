@model PaginationResponseDto<EmployeeShortResponseDto>
@{
    ViewData["Module"] = "Employees";
    var page = Model.PageNumber;
}

<div class="row mt-3">
    @if (Model.TotalPages == 0)
    {
        <div class="col-12">
            <div class="border">
                <h4 class="text-center my-5 ">
                    No Data
                </h4>
            </div>
            
        </div>
    }
    @foreach (var employee in Model.Items)
    {
        <div class="col-6 col-md-4 col-lg-3 mb-3">
            <div class="card d-flex flex-column align-items-center shadow h-100" id="@employee.Id">    
                @if (!employee.HasPicture)
                {
                    <img class="card-img-top card-img rounded-pill mt-4 shadow" src="~/images/user-no-img.png" alt="@employee.FullName">
                }
                else
                {
                    <img class="card-img-top card-img rounded-pill mt-4 shadow" src="@Url.Action("GetEmployeeImage", "Employee", new { id = employee.GuidId })" alt="@employee.FullName">
                }
                
                <div class="card-body text-center">
                    <h6 class="card-title">@employee.FullName</h6>
                    <p class="card-text">@employee.Bio</p>
                    <a href="@Url.Action("GetEmployeeDetails", "Employee", new { employeeId = employee.Id })" class="btn btn-primary">
                        <i class="bi bi-person-vcard"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
<div class="row mt-3">
    <div class="col">
        <partial name="~/Views/Shared/Utilities/_Pagination.cshtml" model="Model" />
    </div>
</div>
