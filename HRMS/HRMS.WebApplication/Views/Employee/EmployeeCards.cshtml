@model PaginationResponseDto<EmployeeShortResponseDto>
@{
    ViewData["Module"] = "Employees";
    var page = Model.PageNumber;
}

<div class="row mt-3">
    @foreach (var employee in Model.Items)
    {
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card d-flex flex-column align-items-center shadow" id="@employee.Id">
                <img class="card-img-top card-img w-50 rounded-pill mt-4 border shadow" src="~/images/user-no-img.png" alt="@employee.FullName">
                <div class="card-body text-center">
                    <h4 class="card-title">@employee.FullName</h4>
                    <p class="card-text">@employee.Bio</p>
                    <a href="@Url.Action("GetEmployeeDetails", "Employee", new { employeeId = employee.Id })" class="btn btn-primary">
                        <i class="fa-solid fa-address-card"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
<div class="row mt-3">
    <div class="col">
        <partial name="~/Views/Shared/Utilities/_Pagination.cshtml" model="Model" />
    </div>
</div>
