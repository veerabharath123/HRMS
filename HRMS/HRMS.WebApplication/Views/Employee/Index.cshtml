@model PaginationResponseDto<EmployeeShortResponseDto>
@{
    ViewData["Module"] = "Employees";
    var page = Model.PageNumber;
}

<div class="container-fluid">
    <h3>Employees</h3>
    <div class="row mt-3">
        <div class="col">
            <a href="@Url.Action("AddEmployee","Employee")" class="btn btn-success"><i class="bi bi-person-plus-fill"></i> New Employee</a>
        </div>
    </div>
    <div id="employee-cards">
        <partial name="~/Views/Employee/EmployeeCards.cshtml" model="Model" />
    </div>

    
</div>
<script nonce="@Html.ScriptNonce()">
    function loadEmployeeImages(images){
        for(const image of images){
            setImageSrc(`div.card#${image.id} > img`, image.data)
        }
    }
    function getEmployeeImages(ids){

    }

    getEmployeeImages($('div.card').map((i,x) => $(x).attr('id')));

    $('div.card > img').on('click', function () {
        const src = this.src; 

        const $img = $('#image-viewer img');
        $img.attr('src', src).css({ transform: 'none' });

        const modal = new bootstrap.Modal(document.getElementById('image-viewer'));
        modal.show();
    });
</script>