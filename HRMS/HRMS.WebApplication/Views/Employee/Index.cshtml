
@{
    ViewData["Module"] = "Employees";
}

<div class="container-fluid">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h3 class="mt-1">@ViewData["Module"]</h3>
    
    <div class="row mt-3">
        <div class="col-12 clearfix">
            <a href="@Url.Action("AddEmployee", "Employee")" class="btn btn-success float-start"><i class="bi bi-person-plus-fill"></i> New Employee</a>
            <button id="filter-modal-btn" class="btn btn-primary float-end shadow-sm" data-bs-toggle="modal" data-bs-target="#emp-filter-modal"><span class="badge bg-warning text-dark me-2"></span> Filters <i class="bi bi-funnel"></i></button
        </div>
    </div>
    <div id="employee-cards">
        
    </div>

    @* Employee filter modal *@
    <div class="modal fade" id="emp-filter-modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Filters</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="emp-filter-form">
                        <div class="row">
                            <div class="col-6">
                                <div class="mb-3">
                                    <label for="department" class="form-label">Department:</label>
                                    <select id="department" asp-items="ViewBag.DepartmentList" multiple name="Department">
                                    </select>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mb-3">
                                    <label for="designation" class="form-label">Designation:</label>
                                    <select id="designation" asp-items="ViewBag.DesignationList" multiple name="Desgination">
                                    </select>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mb-3">
                                    <label for="upload-date" class="form-label">Upload Date:</label>
                                    <select id="upload-date" name="UploadDate">
                                        <option></option>
                                        <option>Today</option>
                                        <option>Last hour</option>
                                        <option>This week</option>
                                        <option>This month</option>
                                        <option>This year</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-6">
                                <div class="mb-3">
                                    <label for="sortby" class="form-label">Sort by:</label>
                                    <select id="sortby" placeholder="">
                                        <option></option>
                                        <option>Lastname</option>
                                        <option>Firstname</option>
                                    </select>
                                </div>
                                <div class="form-check form-switch mb-3">
                                      <input class="form-check-input" type="checkbox" id="sort-order" value="true">
                                      <label class="form-check-label" for="sort-order">Desc</label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-info btn-sm" id="clr-filter-btn">Clear filters</button>
                    <button class="btn btn-primary btn-sm" id="emp-filter-btn">Apply filters</button>
                </div>
            </div>
        </div>
    </div>
    
</div>
<script nonce="@Html.ScriptNonce()">
    const filterModal = new bootstrap.Modal(document.getElementById('emp-filter-modal'));    

    function loadEmployeeImages(images){
        for(const image of images){
            setImageSrc(`div.card#${image.id} > img`, image.imageBase64)
        }
    }
    function getEmployeeImages(ids){
        const request = { IdList: ids.toArray() };

        if(!request.IdList?.length) return;

        ajaxPost(
            '@Url.Action("GetEmployeeImages","Employee")',
            JSON.stringify(request),
            function (response) {
                loadEmployeeImages(response);
            }
        )
    }

    

    $(document).on('click','div.card > img', function () {
        const $card = $(this).parent();
        const src = this.src;
        const title = $card.find('.card-title')?.text() ?? '?';

        $('#image-viewer img').attr('src', src).css({ transform: 'none' });
        $('#image-viewer-label').text(title)

        const modal = new bootstrap.Modal(document.getElementById('image-viewer'));
        modal.show();
    });
    const department = $('#department').selectize({create: false});
    const designation = $('#designation').selectize({create: false});
    $('#sortby').selectize({create: false});
    $('#upload-date').selectize({create: false});
    


    $('#emp-filter-btn').on('click', function(){
        const request = getEmpFilterRequest();
        localStorage.setItem('emp-filter',JSON.stringify(request))
        loadEmpCards(request)
    })
    function getEmpFilterRequest(){
        return {
            Filter:{
                Filters:buildFilters()
            },
            FilterGroup: buildGroupedFilters(),
            Sort: { SortOptions: buildSort() },
            Pagination: {
                PageNumber: 1,
                PageSize: 24,
                MaxPages: 10
            }
        };
    }
    function loadEmpCards(request){
        const filterCount = request?.FilterGroup?.Groups?.length || 0;
        $('#filter-modal-btn span').text(filterCount).removeClass('d-none').addClass(!filterCount?'d-none':'')

        ajaxLoadHtml(
            '@Url.Action("GetEmployees","Employee")',
            JSON.stringify(request),
            '#employee-cards',
            {
                afterLoad: function(){
                    filterModal.hide()
                    getEmployeeImages(
                        $('#employee-cards').find('div.card')
                            .map((i,x) => parseInt($(x).attr('id')))
                    );
                },
                contentType: "application/json",
                processData: false
            }
        )
    }

    const sessionRequest = localStorage.getItem('emp-filter')
    loadEmpCards(JSON.parse(sessionRequest) ?? getEmpFilterRequest());

    function buildGroupedFilters() {

        const root = {
            Operator: "And",    // dep1 OR dep2 OR dep3
            Filters: [],
            Groups: []
        };

        // ----------------------
        // Department group
        // ----------------------
        const departmentSel = department[0].selectize;
        if (departmentSel.items.length > 0) {

            const deptGroup = {
                Operator: "Or",    // dep1 OR dep2 OR dep3
                Filters: [],
                Groups: []
            };

            departmentSel.items.forEach(function (value) {
                const txt = departmentSel.options[value].text;

                deptGroup.Filters.push({
                    PropertyName: "Department",
                    Comparator: "Equals",
                    Value: txt,
                    Operator: "Or",
                    PropertyType: "String"
                });
            });

            root.Groups.push(deptGroup);
        }

        // ----------------------
        // Designation group
        // ----------------------
        const designationSel = designation[0].selectize;
        if (designationSel.items.length > 0) {

            const desGroup = {
                Operator: "Or",   // des1 OR des2 OR des3
                Filters: []
            };

            designationSel.items.forEach(function (value) {
                const txt = designationSel.options[value].text;

                desGroup.Filters.push({
                    PropertyName: "Designation",
                    Comparator: "Equals",
                    Value: txt,
                    Operator: "Or",
                    PropertyType: "String"
                });
            });

            root.Groups.push(desGroup);
        }

        // ----------------------
        // Upload Date (AND group)
        // ----------------------
        const uploadDate = $('#upload-date').val();
        const today = new Date();

        function addUploadDate(dateISOString) {
            root.Groups.push({
                Operator: "And",
                Filters: [
                    {
                        PropertyName: "UploadDate",
                        Comparator: "GreaterThanOrEqual",
                        Value: dateISOString,
                        Operator: "And",
                        PropertyType: "Date"
                    }
                ]
            });
        }

        switch (uploadDate) {
            case "Today":
                addUploadDate(new Date().toISOString().split("T")[0]);
                break;

            case "Last hour":
                addUploadDate(new Date(Date.now() - 3600000).toISOString());
                break;

            case "This week":
                const now = new Date();
                const firstDayOfWeek = new Date(
                    now.setDate(now.getDate() - now.getDay())
                ).toISOString().split("T")[0];
                addUploadDate(firstDayOfWeek);
                break;

            case "This month":
                addUploadDate(
                    new Date(today.getFullYear(), today.getMonth(), 1)
                        .toISOString()
                        .split("T")[0]
                );
                break;

            case "This year":
                addUploadDate(
                    new Date(today.getFullYear(), 0, 1)
                        .toISOString()
                        .split("T")[0]
                );
                break;
        }

        return root.Groups.length ? root : null;
    }


    function buildFilters() {
    const filters = [];

    // ----------------------
    // Department (Selectize)
    // ----------------------
    const departmentSel = department[0].selectize;
        departmentSel.items.forEach(function (value) {
            const txt = departmentSel.options[value].text;

            filters.push({
                PropertyName: "Department",
                Comparator: "Equals",            // enum: FilterComparator.Equals
                Value: txt,
                Operator: "Or",                 // enum: FilterOperator.And
                PropertyType: "String"           // enum: FilterPropertyType.String
            });
        });

        // ----------------------
        // Designation (multi-select)
        // ----------------------
        const designationSel = designation[0].selectize;
        designationSel.items.forEach(function (value) {
            const txt = designationSel.options[value].text;

            filters.push({
                PropertyName: "Designation",
                Comparator: "Equals",            // enum: FilterComparator.Equals
                Value: txt,
                Operator: "Or",                 // enum: FilterOperator.And
                PropertyType: "String"           // enum: FilterPropertyType.String
            });
        });

        // ----------------------
        // UploadDate Logic
        // ----------------------
        const uploadDate = $('#upload-date').val();
        const today = new Date();

        function addDateFilter(dateISOString) {
            filters.push({
                PropertyName: "UploadDate",
                Comparator: "GreaterThanOrEqual",  // ">=" enum
                Value: dateISOString,
                Operator: filters.length > 0 ? "And" : "",
                PropertyType: "Date"
            });
        }

        switch (uploadDate) {
            case "Today":
                addDateFilter(new Date().toISOString().split("T")[0]);
                break;

            case "Last hour":
                addDateFilter(new Date(Date.now() - 3600000).toISOString());
                break;

            case "This week":
                const now = new Date();
                const firstDayOfWeek = new Date(
                    now.setDate(now.getDate() - now.getDay())
                ).toISOString().split("T")[0];
                addDateFilter(firstDayOfWeek);
                break;

            case "This month":
                const firstDayOfMonth = new Date(
                    today.getFullYear(),
                    today.getMonth(),
                    1
                ).toISOString().split("T")[0];
                addDateFilter(firstDayOfMonth);
                break;

            case "This year":
                const firstDayOfYear = new Date(
                    today.getFullYear(),
                    0,
                    1
                ).toISOString().split("T")[0];
                addDateFilter(firstDayOfYear);
                break;
        }

        return filters;
    }

    function buildSort(){
        const sorts = [];
        const sortVal = $('#sortby').val();
        sortVal && sorts.push({
            PropertyName: sortVal,
            Descending: $('#sort-order').is(':checked'),
        });
        return sorts;
    }

    $('#clr-filter-btn').on('click',function(){
        $('#emp-filter-form').trigger('reset');
        resetFilters()
        $('#emp-filter-btn').trigger('click');
    })
    function resetFilters() {
        department[0].selectize.clear();
        designation[0].selectize.clear();
        $('#upload-date').val("");
    }

</script>