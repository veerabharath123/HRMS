@model EmployeeDetaisResponseDto
@{
    ViewData["Title"] = ViewBag.ModuleTitle;
    ViewData["Module"] = "Employees";
}
<style nonce="@Html.ScriptNonce()">
    .profile-picture{
        max-width:10rem;
    }
    .no-list{
        list-style:none;
        padding:inherit;
    }

    .no-list .list-item{
        padding:.5rem 0px
    }
    .list-item.scroll-x{
        overflow-x: auto;
    }
</style>
<div class="container-fluid">
    <partial name="~/Views/Shared/Utilities/_BreadCrumbs.cshtml" />
    <h2 class="mt-1 clearfix">
        @ViewBag.ModuleTitle
        <a class="btn btn-sm btn-primary float-end" href="@Url.Action("EditEmployee", "Employee", new { Model.EmployeeDetails.EmployeeId })"><i class="bi bi-pencil-square me-2"></i>Edit</a>
        <button class="btn btn-sm btn-success float-end me-2"><i class="bi bi-download me-1"></i> Resume</button>
    </h2>

    <div class="row mt-3">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-3">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Profile</h5>
                    <hr />
                    <div class="row">

                        <div class="col-6 col-sm-12 mb-3">
                            <div class="d-flex align-items-center justify-content-center position-relative" id="emp-detail-img-block">
                                @if (!Model.EmployeeDetails.HasPicture)
                                {
                                    <img class="img-thumbnail bg-dark emp-detail-img rounded-circle profile-picture" src="~/images/user-no-img.png" alt="@Model.EmployeeDetails.FirstName">
                                }
                                else
                                {
                                    <img class="img-thumbnail bg-dark emp-detail-img rounded-circle profile-picture" src="@Url.Action("GetEmployeeImage", "Employee", new { id = Model.EmployeeDetails.GuidId })" alt="@Model.EmployeeDetails.FirstName">
                                }
                            </div>
                        </div>
                        <div class="col-6 col-sm-12">
                            <div class="mb-3">
                                <ul class="no-list">
                                    <li class="list-item small"><i class="bi bi-person-workspace me-3"></i>@Model.EmployeeDetails.Designation</li>
                                    <li class="list-item small"><i class="bi bi-building-fill me-3"></i>@Model.EmployeeDetails.Department</li>
                                    <li class="list-item small"><i class="bi bi-cake2-fill me-3"></i>@Model.EmployeeDetails.BirthDate.ToString("MMMM d, yyyy")</li>
                                </ul>
                            </div>
                            <div class="mb-3">
                                @if (!Model.EmployeeDetails.UserExists)
                                {
                                    <button class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#create-user-modal">Create User</button>

                                    <div class="modal fade" id="create-user-modal" tabindex="-1">
                                        <div class="modal-dialog modal-fullscreen-sm-down">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Are you user you want to link?</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                   <form id="link-user">
                                                        <input asp-for="EmployeeDetails.EmployeeId" name="EmployeeId" type="hidden" />
                                                       
                                                        <div class="mb-3 form-control-section">
                                                            <label for="user-email" class="form-label">User Email:</label>
                                                            <input type="email" class="form-control form-control-sm" id="user-email" asp-for="EmployeeDetails.Email" name="Email" readonly>
                                                        </div>
                                                        <div class="mb-3 form-control-section">
                                                            <label for="username" class="form-label">Username:</label>
                                                            <input type="text" class="form-control form-control-sm" id="username" asp-for="EmployeeDetails.UserName" name="UserName" readonly>
                                                        </div>
                                                   </form>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-success" id="link-user-btn">Link User</button>
                                                    <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal">Cancel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <script nonce="@Html.ScriptNonce()">
                                        const modal = document.getElementById('create-user-modal');

                                        const linkUserForm = FormBuilder.create('#link-user', {
                                            builder:{
                                                Email: { required: true, email: true },
                                                EmployeeId: { required: true }
                                            }
                                        });
                                        linkUserForm.addManualSubmitTrigger('#link-user-btn');
                                        linkUserForm.onSubmit(function(isvalid){
                                            if (!isvalid) return

                                            ajaxPost(
                                                '@Url.Action("LinkEmployeeToUser", "Employee")',
                                                linkUserForm.getValueJson(),
                                                function (res) {
                                                    if(!res?.success){
                                                        showNotification({
                                                            type: 'error',
                                                            message: res?.message || 'Something went wrong!',
                                                        });
                                                        return
                                                    }
                                                    bootstap.Modal.getInstance(modal).hide()
                                                    showNotification({
                                                        type: 'success',
                                                        message: res?.message,
                                                    });
                                                }
                                                ,{ contentType: "application/json", processData: false, useDefaultSuccessCallBack: false }
                                            );
                                        });
                                    </script>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-8 col-lg-6 mb-3">
            <div class="card shadow h-100">
                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <h4 class="clearfix">
                                @Model.EmployeeDetails.LastName @Model.EmployeeDetails.FirstName 
                                
                            </h4>
                            <p class="mt-3 small border bg-light p-2">
                                @(string.IsNullOrWhiteSpace(Model.EmployeeDetails.Bio) ? "No Bio." : Model.EmployeeDetails.Bio)
                            </p>

                            <div class="mb-3">
                                <ul class="no-list">
                                    <li class="list-item scroll-x small"><i class="bi bi-envelope me-3"></i>@Model.EmployeeDetails.Email</li>
                                    <li class="list-item scroll-x small"><i class="bi bi-gender-@(Model.EmployeeDetails.Gender.ToLower()) me-3"></i>@Model.EmployeeDetails.Gender</li>
                                </ul>
                            </div>
                        </div>
                     </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-12 col-lg-3">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Contact details</h5>
                    <hr />
                    <h6>Coming Soon</h6>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 col-md-6 col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Project details</h5>
                    <hr />

                    <h6>Coming Soon</h6>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Address details</h5>
                    <hr />

                    <h6>Coming Soon</h6>
                </div>
            </div>
        </div>
    </div>
</div>
